# Public site URL used for canonical links, OG tags, sitemap and feeds.
BLOG_SITE_URL=

# Inkstone blog API origin (server-side only; never exposed to the browser).
BLOG_API_ORIGIN=

# Shared secret for the public API proxy (server-side only).
BLOG_PROXY_KEY=

# HMAC secret for cache purge callbacks (server-side only).
BLOG_PURGE_SECRET=

# Cookie signing secret for protected posts/albums (server-side only).
BLOG_COOKIE_SECRET=

# Optional origins; default to BLOG_API_ORIGIN when unset.
BLOG_MEDIA_ORIGIN=
BLOG_RUNTIME_ORIGIN=

# SSR fetch timeout in milliseconds.
BLOG_API_TIMEOUT_MS=
