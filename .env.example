# Public blog URL used for canonical links, OG tags, sitemap and feeds.
# Example: https://blog.example.com (no trailing slash)
BLOG_SITE_URL=

# Inkstone backend API origin. Defaults to https://inkstone.454470.xyz.
# This is server-side only; browsers never talk to it directly.
BLOG_API_ORIGIN=https://inkstone.454470.xyz

# Must match the backend's BLOG_PROXY_KEY secret. Server-side only.
BLOG_PROXY_KEY=

# Optional runtime origin; defaults to BLOG_API_ORIGIN.
BLOG_RUNTIME_ORIGIN=

# SSR fetch timeout in milliseconds (default 8000).
BLOG_API_TIMEOUT_MS=8000
