---
import TopAppBar from '../components/shell/TopAppBar.astro'
import SideBar from '../components/shell/SideBar.astro'
import Footer from '../components/shell/Footer.astro'
import HeroBanner from '../components/shell/HeroBanner.astro'
import { sidebarHasContent } from '../lib/sidebar'
import { FALLBACK_SITE } from '../server/site-config'

interface Props {
  page?: string
  hero?: boolean
}
const blog = Astro.locals.blog ?? { site: FALLBACK_SITE, categories: [], tags: [], series: [] }
const sidebar = blog.site.sidebar
const { page = 'home', hero = false } = Astro.props
const primary = sidebar.enable && sidebarHasContent(blog, page, 'primary')
const secondary = sidebar.enable && sidebarHasContent(blog, page, 'secondary')
const aside = Astro.slots.has('aside')
// Three columns only when the site asked for a dual rail and both rails carry a card; a
// disabled rail or an empty widget set must not leave a blank track, and a single-rail
// site keeps one column of widgets even though it configures both primary and secondary
// widget types. The outline slot still counts: an article with no cards but with headings
// keeps one narrow rail.
const dual = sidebar.enable && sidebar.arrangement === 'dual' && primary && secondary
const rail = primary || secondary || aside
---
<div class="site-shell" data-page={page}>
  <TopAppBar />
  {hero && <HeroBanner />}
  <main id="main-content" tabindex="-1" class="site-main">
    <div
      class="layout-grid"
      data-sidebar={dual ? 'dual' : 'single'}
      data-side={sidebar.side}
    >
      {dual ? (
        <>
          <SideBar page={page} column="primary" />
          <div class="content-column">
            <slot />
          </div>
          <div class="secondary-column">
            {/* Widgets lead the secondary rail, then the article outline: the site's
                calendar configuration therefore sits above On this page, and any
                other widget the owner assigns to this column keeps that place. */}
            <SideBar page={page} column="secondary" />
            <slot name="aside" />
          </div>
        </>
      ) : (
        <>
          {rail && (
            <div class="secondary-column">
              <slot name="aside" />
              {sidebar.enable && <SideBar page={page} column="all" />}
            </div>
          )}
          <div class="content-column">
            <slot />
          </div>
        </>
      )}
    </div>
  </main>
  <Footer />
</div>
