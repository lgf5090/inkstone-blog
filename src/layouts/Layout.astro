---
import '../styles/global.css'
import '../styles/feature-author.css'
import '../styles/feature-newsletter.css'
import { blogLocale, t } from '../i18n'
import { FALLBACK_SITE } from '../server/site-config'
import FloatingActions from '../components/shell/FloatingActions.astro'
import MusicPlayer from '../components/shell/MusicPlayer.astro'
import { ClientRouter } from 'astro:transitions'

interface Props {
  title?: string
  description?: string
  image?: string | null
  type?: 'website' | 'article'
  canonicalUrl?: string
  noIndex?: boolean
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
}

const blog = Astro.locals.blog ?? { site: FALLBACK_SITE, display: { progressStyle: 'dual' as const } }
const locale = blogLocale(blog.site.site.locale)
const {
  title,
  description = blog.site.site.description,
  image = null,
  type = 'website',
  canonicalUrl,
  noIndex = false,
  jsonLd,
} = Astro.props

const siteTitle = blog.site.site.title || 'Inkstone Blog'
const pageTitle = title ? `${title} · ${siteTitle}` : siteTitle
const configuredOrigin = (import.meta.env.BLOG_SITE_URL ?? '').replace(/\/+$/, '')
const origin = (blog.site.site.url || configuredOrigin || Astro.url.origin).replace(/\/+$/, '')
const canonical = canonicalUrl ? new URL(canonicalUrl) : new URL(Astro.url.pathname + Astro.url.search, origin)
const absoluteImage = image ? new URL(image, origin).href : null
const structured = (Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []).filter(Boolean)
const hue = Number(blog.site.site.themeColor?.hue ?? 315)
// The site stores an arbitrary hue; the shared design system ships seven
// curated accents. Map the stored hue to the nearest one so an old setting
// still lands on the same palette the app uses.
const ACCENT_HUES = [
  ['cinnabar', 30],
  ['indigo', 252],
  ['celadon', 150],
  ['amber', 95],
  ['terracotta', 205],
  ['wisteria', 300],
] as const
const themeStyle = blog.site.site.themeColor?.style
const accent = themeStyle === 'monochrome' || themeStyle === 'neutral'
  ? 'graphite'
  : !Number.isFinite(hue) || hue === 315
    ? 'cinnabar'
    : ACCENT_HUES.reduce(
        (best, [id, value]) => {
          const distance = Math.min(Math.abs(hue - value), 360 - Math.abs(hue - value))
          return distance < best.distance ? { id, distance } : best
        },
        { id: 'cinnabar' as string, distance: 360 },
      ).id
const progressStyle = blog.display?.progressStyle === 'single' ? 'single' : 'dual'
const showTopProgress = type === 'article' && progressStyle === 'dual'
---

<!doctype html>
<html lang={locale} data-theme="light" class="light" data-accent={accent} data-background="paper" data-density="comfortable">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description || pageTitle} />
    <link rel="canonical" href={canonical} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href="/rss.xml" />
    <link rel="alternate" type="application/atom+xml" title={siteTitle} href="/atom.xml" />
    <ClientRouter />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description || pageTitle} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    {absoluteImage && <meta property="og:image" content={absoluteImage} />}
    <meta name="twitter:card" content={absoluteImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description || pageTitle} />
    {absoluteImage && <meta name="twitter:image" content={absoluteImage} />}
    {structured.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item).replace(/</g, '\\u003c')} />
    ))}
    <slot name="head" />
    {blog.site.integrations.umami.enabled && /^[0-9a-f-]{8,}$/i.test(blog.site.integrations.umami.websiteId) && (
      <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id={blog.site.integrations.umami.websiteId}></script>
    )}
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme')
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
        const dark = stored === 'dark' || (stored !== 'light' && prefersDark)
        const root = document.documentElement
        root.classList.toggle('dark', dark)
        root.classList.toggle('light', !dark)
        root.dataset.theme = dark ? 'dark' : 'light'
        const accent = localStorage.getItem('accent')
        const background = localStorage.getItem('background')
        const density = localStorage.getItem('density')
        if (accent) root.dataset.accent = accent
        if (background) root.dataset.background = background
        if (density) root.dataset.density = density
        root.dataset.texture = localStorage.getItem('texture') || 'none'
        root.dataset.wallpaper = localStorage.getItem('wallpaper') || 'plain'
        root.dataset.reduceMotion = localStorage.getItem('reduce-motion') === '1' ? 'true' : 'false'
      })()
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{t(locale, 'common.skipToContent')}</a>
    <script is:inline>
      (() => {
        if (window.__blogSwapCleanupInstalled) return
        window.__blogSwapCleanupInstalled = true
        window.__blogCleanups = new Map()
        document.addEventListener('astro:after-swap', () => {
          if (window.umami && typeof window.umami.track === 'function') window.umami.track()
        })
        document.addEventListener('astro:before-swap', () => {
          for (const cleanup of window.__blogCleanups.values()) {
            try {
              cleanup()
            } catch (error) {
              console.warn('[blog] page cleanup failed', error)
            }
          }
          window.__blogCleanups.clear()
        })
        window.__blogRegisterCleanup = (key, cleanup) => {
          window.__blogCleanups.get(key)?.()
          window.__blogCleanups.set(key, cleanup)
        }
      })()
    </script>
    <script is:inline>
      (() => {
        if (window.__blogMenuBehaviorInstalled) return
        window.__blogMenuBehaviorInstalled = true
        const openMenus = () => document.querySelectorAll('details.nav-menu[open], details.mobile-nav-group[open]')
        document.addEventListener('click', (event) => {
          for (const menu of openMenus()) {
            if (!menu.contains(event.target)) menu.open = false
          }
        })
        document.addEventListener('keydown', (event) => {
          if (event.key !== 'Escape') return
          const menus = openMenus()
          const menu = menus[menus.length - 1]
          if (!menu) return
          menu.open = false
          menu.querySelector('summary')?.focus()
        })
      })()
    </script>
    {showTopProgress && (
      <div class="reading-progress-top" data-reading-progress aria-hidden="true"><span></span></div>
    )}
    <slot />
    <FloatingActions />
    <MusicPlayer />

<script is:inline data-astro-rerun>
  (() => {
    const toc = document.querySelector('[data-toc]')
    const list = toc && toc.querySelector('[data-toc-list]')
    if (!toc || !list) return
    const items = [...list.querySelectorAll('[data-toc-item]')]
    const folds = new Map()
    let filtering = ''
    let observer = null

    const depthOf = (item) => Number(item.getAttribute('data-depth')) || 1
    const applyVisibility = () => {
      if (filtering) {
        const query = filtering.toLocaleLowerCase()
        const visible = new Set()
        items.forEach((item, index) => {
          if (item.textContent.toLocaleLowerCase().includes(query)) {
            visible.add(index)
            let level = depthOf(item)
            for (let cursor = index - 1; cursor >= 0 && level > 1; cursor--) {
              if (depthOf(items[cursor]) < level) {
                visible.add(cursor)
                level = depthOf(items[cursor])
              }
            }
          }
        })
        items.forEach((item, index) => { item.hidden = !visible.has(index) })
        toc.querySelector('[data-toc-empty]').hidden = visible.size > 0
        return
      }
      toc.querySelector('[data-toc-empty]').hidden = true
      items.forEach((item, index) => {
        let hidden = false
        for (const [foldIndex, folded] of folds) {
          if (!folded || foldIndex >= index) continue
          if (depthOf(items[foldIndex]) < depthOf(item)) {
            hidden = true
            break
          }
        }
        item.hidden = hidden
      })
    }

    items.forEach((item, index) => {
      const button = item.querySelector('[data-toc-fold]')
      if (!button) return
      button.addEventListener('click', (event) => {
        event.preventDefault()
        event.stopPropagation()
        const folded = !folds.get(index)
        folds.set(index, folded)
        button.setAttribute('aria-expanded', String(!folded))
        const label = folded ? button.getAttribute('data-unfold') : button.getAttribute('data-fold')
        if (label) {
          button.setAttribute('aria-label', label)
          button.setAttribute('title', label)
        }
        item.classList.toggle('is-folded', folded)
        applyVisibility()
      })
    })

    const filter = toc.querySelector('[data-toc-filter]')
    filter?.addEventListener('input', () => {
      filtering = filter.value.trim()
      applyVisibility()
    })

    const progress = toc.querySelector('[data-toc-progress]')
    const bar = toc.querySelector('.toc-progress')
    const article = document.querySelector('[data-blog-reading-host]') || document.querySelector('.article-body')
    const updateProgress = () => {
      if (!article || !progress || !bar) return
      const rect = article.getBoundingClientRect()
      const start = rect.top + window.scrollY
      const end = start + Math.max(0, article.offsetHeight - window.innerHeight)
      const value = end > start ? Math.min(1, Math.max(0, (window.scrollY - start) / (end - start))) : 0
      progress.style.width = `${Math.round(value * 100)}%`
      bar.setAttribute('aria-valuenow', String(Math.round(value * 100)))
    }
    updateProgress()
    window.addEventListener('scroll', updateProgress, { passive: true })
    window.addEventListener('resize', updateProgress)

    const bindSpy = () => {
      observer?.disconnect()
      const links = [...document.querySelectorAll('[data-toc-link]')]
      if (links.length === 0 || !('IntersectionObserver' in window)) return
      const byId = new Map(links.map((link) => [link.getAttribute('data-toc-link'), link]))
      observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue
          links.forEach((link) => link.removeAttribute('aria-current'))
          byId.get(entry.target.id)?.setAttribute('aria-current', 'location')
        }
      }, { rootMargin: '-20% 0px -70% 0px' })
      for (const id of byId.keys()) {
        const heading = document.getElementById(id)
        if (heading) observer.observe(heading)
      }
    }
    bindSpy()
    document.addEventListener('blog:reading-ready', bindSpy)
    document.addEventListener('blog:reading-ready', updateProgress)
    window.__blogRegisterCleanup?.('toc', () => {
      observer?.disconnect()
      window.removeEventListener('scroll', updateProgress)
      window.removeEventListener('resize', updateProgress)
      document.removeEventListener('blog:reading-ready', bindSpy)
      document.removeEventListener('blog:reading-ready', updateProgress)
    })
  })()
</script>

<script is:inline data-astro-rerun>
  (() => {
    const target = document.querySelector('[data-hero-typewriter]')
    if (!target || !target.hasAttribute('data-animate')) return
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return
    const text = target.getAttribute('data-full') || target.textContent || ''
    target.textContent = ''
    let index = 0
    const timer = window.setInterval(() => {
      target.textContent = text.slice(0, ++index)
      if (index >= text.length) window.clearInterval(timer)
    }, 42)
    window.__blogRegisterCleanup?.('banner', () => window.clearInterval(timer))
  })()
</script>

<script is:inline data-astro-rerun>
  (() => {
    document.querySelectorAll('[data-announcement]').forEach((card) => {
      const key = 'blog-announcement:' + (card.getAttribute('data-announcement') || '')
      if (localStorage.getItem(key) === '1') card.hidden = true
      card.querySelector('[data-announcement-close]')?.addEventListener('click', () => {
        localStorage.setItem(key, '1')
        card.hidden = true
      })
    })
  })()
</script>

<script is:inline data-astro-rerun>
  // The stored snapshot carries the code block's copy label as a bare text
  // node. Upgrade it to the same button the reading runtime draws so the
  // article behaves like the app's reading view even without the runtime.
  (() => {
    const zh = (document.documentElement.lang || '').toLowerCase().startsWith('zh')
    const labelCopy = zh ? '复制' : 'Copy'
    const labelCopied = zh ? '已复制' : 'Copied'
    document.querySelectorAll('.ink-prose .code-block-head').forEach((head) => {
      if (head.querySelector('.code-copy')) return
      const block = head.closest('.code-block')
      const pre = block && block.querySelector('pre')
      if (!pre) return
      const node = [...head.childNodes].find(
        (child) => child.nodeType === 3 && child.textContent && child.textContent.trim(),
      )
      if (!node) return
      const button = document.createElement('button')
      button.type = 'button'
      button.className = 'code-copy'
      button.setAttribute('aria-label', labelCopy)
      button.textContent = node.textContent.trim()
      node.parentNode.replaceChild(button, node)
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(pre.innerText)
          button.textContent = labelCopied
          button.classList.add('copied')
        } catch {
          button.textContent = labelCopy
        }
        window.setTimeout(() => {
          button.textContent = labelCopy
          button.classList.remove('copied')
        }, 1600)
      })
    })
  })()
</script>

<script is:inline data-astro-rerun>
  document.querySelectorAll('[data-share-link]').forEach((button) => {
    button.addEventListener('click', async () => {
      const link = button.getAttribute('data-share-link')
      if (!link) return
      try {
        await navigator.clipboard.writeText(link)
        const label = button.getAttribute('data-copied-label') || 'Copied'
        const previous = button.textContent
        button.textContent = label
        window.setTimeout(() => { button.textContent = previous }, 1600)
      } catch {
        button.textContent = button.getAttribute('data-copy-failed') || button.textContent
      }
    })
  })
</script>
<script is:inline data-astro-rerun>
    (() => {
      const host = document.querySelector('[data-blog-reading-host]')
      const snapshot = host && host.querySelector('[data-blog-snapshot]')
      let config = null
      try {
        config = JSON.parse(host?.getAttribute('data-runtime-config') || 'null')
      } catch {
        config = null
      }
      if (!host || !snapshot || !config || !config.runtimeUrl) return
      const { runtimeUrl, runtimeAssetBase, runtimeVersion, postSlug, readerLocale, runtimeLabels, contextMenuConfig, devRuntimeOrigin, lazy, stripLeadingTitle } = config
      const stripTitleHeading = (value) => {
        const frontmatter = /^(---\r?\n[\s\S]*?\r?\n---\r?\n)/.exec(value)
        const head = frontmatter ? frontmatter[1] : ''
        let body = frontmatter ? value.slice(head.length) : value
        body = body.replace(/^\s*<h1\b[^>]*>[\s\S]*?<\/h1>\s*/i, '')
        body = body.replace(/^\s*#\s+[^\n]*(?:\n+|$)/, '')
        return head + body
      }
      let cancelled = false
      let stage = null
      let handle = null
      window.__blogRegisterCleanup?.('reading', () => {
        cancelled = true
        try {
          handle?.unmount()
        } catch (error) {
          console.warn('[blog] reading runtime cleanup failed', error)
        }
        handle = null
        stage?.remove()
      })
      const keepSnapshot = (error) => {
        console.warn('[blog] reading runtime unavailable; keeping the stored snapshot', error)
      }
      const boot = async () => {
        if (cancelled || !document.contains(host)) return
        try {
          if (devRuntimeOrigin) {
            // The runtime is served by the Inkstone dev server, whose React plugin expects its
            // refresh preamble on the importing page. Production loads a built bundle and never
            // reaches this branch.
            const refresh = await import(devRuntimeOrigin + '/@react-refresh')
            refresh.injectIntoGlobalHook(window)
            window.$RefreshReg$ = () => {}
            window.$RefreshSig$ = () => (type) => type
            window.__vite_plugin_react_preamble_installed__ = true
          }
          await import(runtimeUrl)
        } catch (error) {
          keepSnapshot(error)
          return
        }
        if (cancelled || !document.contains(host)) return
        const reading = window.InkstoneReading
        if (!reading || reading.version !== runtimeVersion) {
          keepSnapshot(new Error('reading runtime version mismatch'))
          return
        }
        let detail
        try {
          // Not the HTTP cache: the snapshot beside this fetch can already be a newer revision.
          const response = await fetch('/_blog/post/' + encodeURIComponent(postSlug), { headers: { accept: 'application/json' }, cache: 'no-store' })
          if (!response.ok) throw new Error('post body ' + response.status)
          detail = await response.json()
        } catch (error) {
          keepSnapshot(error)
          return
        }
        if (!detail || typeof detail.content !== 'string') {
          keepSnapshot(new Error('post body missing'))
          return
        }
        const content = stripLeadingTitle ? stripTitleHeading(detail.content) : detail.content
        if (!devRuntimeOrigin && runtimeAssetBase && !document.querySelector('link[data-blog-runtime-style]')) {
          const style = document.createElement('link')
          style.rel = 'stylesheet'
          style.href = runtimeAssetBase + 'runtime.css'
          style.setAttribute('data-blog-runtime-style', '')
          document.head.appendChild(style)
        }
        if (cancelled || !document.contains(host)) return
        stage = document.createElement('div')
        stage.className = 'blog-runtime-stage'
        host.appendChild(stage)
        const selfPost = '/posts/' + encodeURIComponent(postSlug)
        const wikiLinks = [{ target: detail.title, href: selfPost }]
        for (const link of detail.wikiLinks || []) {
          if (!link || !link.slug || !link.target) continue
          wikiLinks.push({ target: link.target, href: '/posts/' + encodeURIComponent(link.slug) })
        }
        try {
          handle = await reading.mount({
            container: stage,
            content,
            noteTitle: detail.title,
            embeds: detail.embeds || [],
            assets: detail.assets || [],
            settings: detail.settings,
            locale: readerLocale,
            assetBase: runtimeAssetBase,
            wikiLinks,
            labels: runtimeLabels,
            contextMenu: contextMenuConfig,
            tagHref: (name) => '/tags/' + encodeURIComponent(name),
          })
        } catch (error) {
          stage.remove()
          stage = null
          keepSnapshot(error)
          return
        }
        if (cancelled) {
          handle?.unmount()
          handle = null
          stage.remove()
          stage = null
          return
        }
        let attempts = 0
        const reveal = () => {
          if (cancelled) return
          if (!stage.querySelector('[data-preview-content]')) {
            if (++attempts > 120) {
              if (handle) handle.unmount()
              stage.remove()
              keepSnapshot(new Error('reading surface did not render'))
              return
            }
            window.setTimeout(reveal, 16)
            return
          }
          // The page already owns the single H1 (the article title). The runtime renders the note
          // body verbatim, so a body-level H1 would compete with it; demote those to H2 while
          // keeping their ids for TOC anchors.
          for (const heading of stage.querySelectorAll('h1')) {
            const replacement = document.createElement('h2')
            for (const attribute of [...heading.attributes]) replacement.setAttribute(attribute.name, attribute.value)
            replacement.innerHTML = heading.innerHTML
            heading.replaceWith(replacement)
          }
          // Removed rather than hidden: both surfaces carry the same heading ids, and a hidden
          // duplicate would win `getElementById` for every TOC anchor and scroll-spy lookup.
          snapshot.remove()
          stage.classList.add('is-ready')
          document.dispatchEvent(new CustomEvent('blog:reading-ready'))
        }
        // A timer rather than requestAnimationFrame: a background tab does not run animation
        // frames, and a reader who opened the article there would keep the still until they returned.
        window.setTimeout(reveal, 16)
      }
      if (!lazy) {
        if (typeof window.requestIdleCallback === 'function') window.requestIdleCallback(boot, { timeout: 3000 })
        else window.setTimeout(boot, 200)
        return
      }
      let requested = false
      const trigger = (event) => {
        if (requested) return
        if (event.type === 'pointerover' && event.pointerType !== 'mouse') return
        requested = true
        host.removeEventListener('pointerover', trigger)
        host.removeEventListener('pointerdown', trigger)
        host.removeEventListener('focusin', trigger)
        void boot()
      }
      host.addEventListener('pointerover', trigger, { passive: true })
      host.addEventListener('pointerdown', trigger, { passive: true })
      host.addEventListener('focusin', trigger)
      window.__blogRegisterCleanup?.('reading-lazy', () => {
        host.removeEventListener('pointerover', trigger)
        host.removeEventListener('pointerdown', trigger)
        host.removeEventListener('focusin', trigger)
      })
    })()
  </script>

    <script is:inline data-astro-rerun>
      (() => {
        const valid = new Set(['list', 'grid', 'masonry'])
        let frame = 0
        const pack = (list) => {
          const cards = [...list.children]
          for (const card of cards) {
            card.style.gridColumnStart = ''
            card.style.gridRowEnd = ''
          }
          if (list.getAttribute('data-mode') !== 'masonry' || cards.length === 0) return
          const columns = getComputedStyle(list).gridTemplateColumns.split(' ').filter(Boolean).length
          if (columns <= 0) return
          const heights = new Array(columns).fill(0)
          for (const card of cards) {
            let shortest = 0
            for (let index = 1; index < columns; index++) {
              if (heights[index] < heights[shortest]) shortest = index
            }
            const height = card.getBoundingClientRect().height + 16
            card.style.gridColumnStart = String(shortest + 1)
            card.style.gridRowEnd = 'span ' + Math.ceil(height / 8)
            heights[shortest] += height
          }
        }
        const apply = (override) => {
          const stored = override ?? localStorage.getItem('post-list-mode')
          document.querySelectorAll('[data-post-list]').forEach((list) => {
            if (stored && valid.has(stored)) list.setAttribute('data-mode', stored)
            pack(list)
          })
        }
        const schedule = () => {
          cancelAnimationFrame(frame)
          frame = requestAnimationFrame(() => apply())
        }
        window.__blogApplyPostListMode = (mode) => apply(valid.has(mode) ? mode : null)
        apply()
        document.fonts?.ready.then(() => apply())
        window.addEventListener('resize', schedule)
        window.__blogRegisterCleanup?.('post-list-layout', () => {
          cancelAnimationFrame(frame)
          window.removeEventListener('resize', schedule)
          delete window.__blogApplyPostListMode
        })

        const bloomImages = () => {
          document.querySelectorAll('[data-blog-reading-host] img').forEach((image) => {
            if (image.closest('.image-bloom')) return
            const source = image.currentSrc || image.src
            if (!source) return
            const wrapper = document.createElement('span')
            wrapper.className = 'image-bloom'
            wrapper.style.backgroundImage = `url("${source.replace(/"/g, '%22')}")`
            image.parentNode?.insertBefore(wrapper, image)
            wrapper.appendChild(image)
            const loaded = () => wrapper.classList.add('is-loaded')
            if (image.complete) loaded()
            else image.addEventListener('load', loaded, { once: true })
          })
        }
        bloomImages()
        const onReadingReady = () => bloomImages()
        document.addEventListener('blog:reading-ready', onReadingReady)
        let bloomFrame = 0
        const scheduleBloom = () => {
          cancelAnimationFrame(bloomFrame)
          bloomFrame = requestAnimationFrame(bloomImages)
        }
        const bloomHost = document.querySelector('[data-blog-reading-host]')
        const bloomObserver = new MutationObserver(scheduleBloom)
        if (bloomHost) bloomObserver.observe(bloomHost, { childList: true, subtree: true })
        const bloomTimers = [600, 1500].map((delay) => window.setTimeout(bloomImages, delay))
        window.__blogRegisterCleanup?.('image-bloom', () => {
          document.removeEventListener('blog:reading-ready', onReadingReady)
          bloomObserver.disconnect()
          cancelAnimationFrame(bloomFrame)
          bloomTimers.forEach((timer) => clearTimeout(timer))
        })

        const progress = document.querySelector('[data-reading-progress] span')
        const article = document.querySelector('[data-blog-reading-host]')
        if (progress && article) {
          const update = () => {
            const rect = article.getBoundingClientRect()
            const total = Math.max(1, rect.height - window.innerHeight)
            const passed = Math.min(Math.max(-rect.top, 0), total)
            progress.style.width = `${(passed / total) * 100}%`
          }
          window.addEventListener('scroll', update, { passive: true })
          update()
          window.__blogRegisterCleanup?.('reading-progress', () => {
            window.removeEventListener('scroll', update)
            document.removeEventListener('blog:reading-ready', onReadingReady)
          })
        }
      })()
    </script>
  </body>
</html>
