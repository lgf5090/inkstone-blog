---
import '../styles/global.css'
import { blogLocale } from '../i18n'
import { FALLBACK_SITE } from '../server/site-config'

interface Props {
  title?: string
  description?: string
  image?: string | null
  type?: 'website' | 'article'
  noIndex?: boolean
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
}

const blog = Astro.locals.blog ?? { site: FALLBACK_SITE }
const locale = blogLocale(blog.site.site.locale)
const {
  title,
  description = blog.site.site.description,
  image = null,
  type = 'website',
  noIndex = false,
  jsonLd,
} = Astro.props

const siteTitle = blog.site.site.title || 'Inkstone Blog'
const pageTitle = title ? `${title} · ${siteTitle}` : siteTitle
const configuredOrigin = (import.meta.env.BLOG_SITE_URL ?? '').replace(/\/+$/, '')
const origin = configuredOrigin || Astro.url.origin
const canonical = new URL(Astro.url.pathname + Astro.url.search, origin)
const absoluteImage = image ? new URL(image, origin).href : null
const structured = (Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []).filter(Boolean)
const hue = Number(blog.site.site.themeColor?.hue ?? 315)
---

<!doctype html>
<html lang={locale} data-theme="light" class="light" data-accent="cinnabar" data-background="paper" data-density="comfortable" style={`--hue:${hue}`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description || pageTitle} />
    <link rel="canonical" href={canonical} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href="/rss.xml" />
    <link rel="alternate" type="application/atom+xml" title={siteTitle} href="/atom.xml" />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description || pageTitle} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    {absoluteImage && <meta property="og:image" content={absoluteImage} />}
    <meta name="twitter:card" content={absoluteImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description || pageTitle} />
    {absoluteImage && <meta name="twitter:image" content={absoluteImage} />}
    <meta name="theme-color" content={`oklch(0.47 0.16 ${hue})`} />
    {structured.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
    <slot name="head" />
    <script is:inline define:vars={{ hue }}>
      (() => {
        const stored = localStorage.getItem('theme')
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
        const dark = stored === 'dark' || (stored !== 'light' && prefersDark)
        const root = document.documentElement
        root.classList.toggle('dark', dark)
        root.classList.toggle('light', !dark)
        root.dataset.theme = dark ? 'dark' : 'light'
        root.style.setProperty('--hue', String(localStorage.getItem('hue') || hue))
        const accent = localStorage.getItem('accent')
        const background = localStorage.getItem('background')
        const density = localStorage.getItem('density')
        if (accent) root.dataset.accent = accent
        if (background) root.dataset.background = background
        if (density) root.dataset.density = density
      })()
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
