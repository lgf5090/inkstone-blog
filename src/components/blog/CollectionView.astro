---
import { mediaUrl } from '../../lib/blog-api'
import type { BlogCollectionItem, BlogCollectionKind } from '../../lib/blog-types'
import { blogLocale, t } from '../../i18n'
import { FALLBACK_SITE } from '../../server/site-config'

interface Props {
  kind: BlogCollectionKind
  items: BlogCollectionItem[]
}
const blog = Astro.locals.blog ?? { site: FALLBACK_SITE }
const locale = blogLocale(blog.site.site.locale)
const { kind, items } = Astro.props
const str = (data: Record<string, unknown>, key: string): string => typeof data[key] === 'string' ? data[key] as string : ''
const num = (data: Record<string, unknown>, key: string): number | null => typeof data[key] === 'number' && Number.isFinite(data[key]) ? data[key] as number : null
const arr = (data: Record<string, unknown>, key: string): unknown[] => Array.isArray(data[key]) ? data[key] as unknown[] : []
const asset = (value: unknown): string | null => typeof value === 'string' && value
  ? mediaUrl(`/api/blog/assets/${value}`)
  : null
---
{items.length === 0 ? (
  <div class="empty-state">{t(locale, 'collections.empty')}</div>
) : kind === 'friends' ? (
  <div class="collection-grid">
    {items.map((item) => {
      const data = item.data
      const url = str(data, 'url')
      const avatar = asset(data.avatar_asset_id) || str(data, 'avatar')
      return (
        <article class="collection-card">
          <div style="display:flex;align-items:center;gap:0.7rem">
            {avatar && <img src={avatar} alt="" width="44" height="44" loading="lazy" style="border-radius:999px;object-fit:cover" />}
            <h2>{url ? <a href={url} target="_blank" rel="noopener noreferrer">{item.title}</a> : item.title}</h2>
          </div>
          {str(data, 'description') && <p>{str(data, 'description')}</p>}
          {arr(data, 'tags').length > 0 && <div class="post-card-tags">{arr(data, 'tags').map((tag) => <span class="chip">#{String(tag)}</span>)}</div>}
        </article>
      )
    })}
  </div>
) : kind === 'projects' ? (
  <div class="collection-grid">
    {items.map((item) => {
      const data = item.data
      const cover = asset(data.cover_asset_id)
      const repository = str(data, 'repository')
      return (
        <article class="collection-card">
          {cover && <img class="post-card-cover" src={cover} alt="" loading="lazy" />}
          <h2>{item.title}</h2>
          {str(data, 'summary') && <p>{str(data, 'summary')}</p>}
          <div class="post-card-tags">
            {str(data, 'category') && <span class="chip">{str(data, 'category')}</span>}
            {str(data, 'phase') && <span class="chip">{str(data, 'phase')}</span>}
            {str(data, 'year') && <span class="chip">{str(data, 'year')}</span>}
            {arr(data, 'technologies').map((tech) => <span class="chip">{String(tech)}</span>)}
          </div>
          {repository && <p><a class="chip" href={repository} target="_blank" rel="noopener noreferrer">{t(locale, 'common.repository')}</a></p>}
        </article>
      )
    })}
  </div>
) : kind === 'skills' ? (
  <div class="collection-grid">
    {items.map((item) => {
      const data = item.data
      const level = num(data, 'level')
      return (
        <article class="collection-card">
          <h2>{item.title}</h2>
          {str(data, 'description') && <p>{str(data, 'description')}</p>}
          {str(data, 'category') && <p class="muted">{str(data, 'category')}</p>}
          {level !== null && <div class="skill-meter" aria-label={`${item.title}: ${level}%`}><span style={`width:${Math.min(100, Math.max(0, level))}%`} /></div>}
        </article>
      )
    })}
  </div>
) : kind === 'devices' ? (
  <div class="collection-grid">
    {items.map((item) => {
      const data = item.data
      const specs = arr(data, 'specs')
      return (
        <article class="collection-card">
          <h2>{item.title}</h2>
          <p class="muted">{[str(data, 'brand'), str(data, 'category'), str(data, 'status'), str(data, 'year')].filter(Boolean).join(' · ')}</p>
          {str(data, 'description') && <p>{str(data, 'description')}</p>}
          {specs.length > 0 && (
            <ul class="widget-list">
              {specs.map((spec) => typeof spec === 'object' && spec
                ? <li><span>{String((spec as Record<string, unknown>).label ?? '')}</span><span class="widget-count">{String((spec as Record<string, unknown>).value ?? '')}</span></li>
                : <li><span>{String(spec)}</span></li>)}
            </ul>
          )}
          {str(data, 'link') && <a class="chip" href={str(data, 'link')} target="_blank" rel="noopener noreferrer">{t(locale, 'common.link')}</a>}
        </article>
      )
    })}
  </div>
) : kind === 'games' ? (
  <div class="collection-grid">
    {items.map((item) => {
      const data = item.data
      const cover = asset(data.cover_asset_id)
      const rating = num(data, 'rating')
      const hours = num(data, 'hours')
      return (
        <article class="collection-card">
          {cover && <img class="post-card-cover" src={cover} alt="" loading="lazy" />}
          <h2>{item.title}</h2>
          <p class="muted">{[str(data, 'developer'), str(data, 'platform'), str(data, 'year'), str(data, 'status')].filter(Boolean).join(' · ')}</p>
          {rating !== null && <p class="muted">★ {rating}</p>}
          {hours !== null && <p class="muted">{hours} h</p>}
          {str(data, 'description') && <p>{str(data, 'description')}</p>}
          <div class="post-card-tags">{arr(data, 'tags').map((tag) => <span class="chip">#{String(tag)}</span>)}</div>
          {str(data, 'link') && <a class="chip" href={str(data, 'link')} target="_blank" rel="noopener noreferrer">Link</a>}
        </article>
      )
    })}
  </div>
) : kind === 'anime' ? (
  <div class="collection-grid">
    {items.map((item) => {
      const data = item.data
      const cover = asset(data.cover_asset_id) || str(data, 'cover_url')
      const watched = num(data, 'watched')
      const total = num(data, 'total')
      const rating = num(data, 'rating')
      return (
        <article class="collection-card">
          {cover && <img class="post-card-cover" src={cover} alt="" loading="lazy" />}
          <h2>{item.title}</h2>
          <p class="muted">{[str(data, 'studio'), str(data, 'year'), str(data, 'status')].filter(Boolean).join(' · ')}</p>
          {watched !== null && <p class="muted">{watched}{total ? ` / ${total}` : ''} {t(locale, 'common.episodes')}</p>}
          {rating !== null && <p class="muted">★ {rating}</p>}
          <div class="post-card-tags">{arr(data, 'genres').map((genre) => <span class="chip">{String(genre)}</span>)}</div>
          {str(data, 'link') && <a class="chip" href={str(data, 'link')} target="_blank" rel="noopener noreferrer">Link</a>}
        </article>
      )
    })}
  </div>
) : kind === 'timeline' ? (
  <div class="collection-grid">
    {items.map((item) => {
      const data = item.data
      const links = arr(data, 'links')
      return (
        <article class="collection-card">
          <p class="muted">{str(data, 'date')} {str(data, 'category') && `· ${str(data, 'category')}`}</p>
          <h2>{item.title}</h2>
          {str(data, 'subtitle') && <p>{str(data, 'subtitle')}</p>}
          {str(data, 'description') && <p>{str(data, 'description')}</p>}
          {arr(data, 'highlights').length > 0 && (
            <ul class="widget-list">{arr(data, 'highlights').map((highlight) => <li><span>{String(highlight)}</span></li>)}</ul>
          )}
          <div class="post-card-tags">
            {arr(data, 'tags').map((tag) => <span class="chip">#{String(tag)}</span>)}
            {links.map((link) => typeof link === 'object' && link
              ? <a class="chip" href={String((link as Record<string, unknown>).url ?? '')} target="_blank" rel="noopener noreferrer">{String((link as Record<string, unknown>).label ?? 'Link')}</a>
              : null)}
          </div>
        </article>
      )
    })}
  </div>
) : (
  <div class="collection-grid">
    {items.map((item) => (
      <article class="collection-card">
        <h2>{item.title}</h2>
        {str(item.data, 'description') && <p>{str(item.data, 'description')}</p>}
      </article>
    ))}
  </div>
)}
