---
import { blogLocale, t } from '../../i18n'
import { FALLBACK_SITE } from '../../server/site-config'
import type { BlogHeading } from '../../lib/blog-types'
interface Props {
  headings: BlogHeading[]
  depth?: number
}
const blog = Astro.locals.blog ?? { site: FALLBACK_SITE }
const locale = blogLocale(blog.site.site.locale)
const { headings, depth = 3 } = Astro.props
const items = headings.filter((heading) => heading.depth <= depth)
const hasChildren = (index: number) => (items[index + 1]?.depth ?? 0) > items[index]!.depth
---
{items.length > 0 && (
  <aside class="toc-card" aria-label={t(locale, 'common.tableOfContents')} data-toc>
    <div class="toc-head">
      <h2 class="sidebar-title">{t(locale, 'common.tableOfContents')}</h2>
      <div class="toc-progress" role="progressbar" aria-label={t(locale, 'common.readingProgress')} aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <span data-toc-progress></span>
      </div>
    </div>
    <label class="toc-search">
      <span class="toc-search-label">{t(locale, 'common.tocSearch')}</span>
      <input type="search" data-toc-filter placeholder={t(locale, 'common.tocSearch')} aria-label={t(locale, 'common.tocSearch')} />
    </label>
    <ol class="toc-list" data-toc-list>
      {items.map((heading, index) => (
        <li class="toc-item" data-toc-item data-depth={heading.depth} style={`padding-left:${Math.max(0, heading.depth - 1) * 0.6}rem`}>
          <div class="toc-row">
            {hasChildren(index) ? (
              <button type="button" class="toc-fold" data-toc-fold data-fold={t(locale, 'common.tocFold')} data-unfold={t(locale, 'common.tocUnfold')} aria-expanded="true" aria-label={t(locale, 'common.tocFold')} title={t(locale, 'common.tocFold')}>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
              </button>
            ) : <span class="toc-fold-space" aria-hidden="true"></span>}
            <a href={`#${heading.slug}`} data-toc-link={heading.slug}>{heading.text}</a>
          </div>
        </li>
      ))}
    </ol>
    <p class="toc-empty" data-toc-empty hidden>{t(locale, 'common.noHeadingsMatch')}</p>
  </aside>
)}

