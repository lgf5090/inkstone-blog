---
import Icon from '../Icon.astro'
import { loadCalendar, loadPosts, mediaUrl } from '../../lib/blog-api'
import { safeUrl } from '../../lib/format'
import { blogLocale, t } from '../../i18n'
import { FALLBACK_SITE } from '../../server/site-config'
import type { BlogCalendarEntry, BlogPostSummary, BlogWidget } from '../../lib/blog-types'
import CalendarWidget from '../blog/CalendarWidget.svelte'

interface Props {
  column?: 'primary' | 'secondary' | 'all'
  page?: string
}
const blog = Astro.locals.blog ?? {
  site: FALLBACK_SITE,
  categories: [],
  tags: [],
  series: [],
  music: { enabled: false, provider: 'none', tracks: [], defaultVolume: 0.7, defaultMode: 'sequence' },
  runtimeVersion: 'inkstone-blog-v3',
}
const locale = blogLocale(blog.site.site.locale)
const column = Astro.props.column ?? 'primary'
const page = Astro.props.page ?? 'home'
const widgets = blog.site.widgets ?? []
const fallbackWidgets = [
  { id: 'profile', type: 'profile', title: '', enabled: true, config: {} },
  { id: 'search', type: 'search', title: '', enabled: true, config: {} },
  { id: 'categories', type: 'categories', title: '', enabled: true, config: {} },
  { id: 'tags', type: 'tags', title: '', enabled: true, config: {} },
  { id: 'series', type: 'series', title: '', enabled: true, config: {} },
]
const all: BlogWidget[] = widgets.length ? widgets : fallbackWidgets
const secondaryTypes = new Set(['categories', 'tags', 'series', 'stats', 'calendar'])
const columnOf = (widget: BlogWidget): 'primary' | 'secondary' => widget.column === 'primary' || widget.column === 'secondary'
  ? widget.column
  : secondaryTypes.has(widget.type) ? 'secondary' : 'primary'
const visible = all.filter((widget) => widget.enabled
  && (!widget.pages?.length || widget.pages.includes(page))
  && (column === 'all' || columnOf(widget) === column))
const ordered = [...visible].sort((left, right) => (left.slot === 'top' ? 0 : 1) - (right.slot === 'top' ? 0 : 1))
const recentWidget = visible.some((widget) => widget.type === 'recent')
let recent: BlogPostSummary[] = []
if (recentWidget) {
  try {
    recent = (await loadPosts({ limit: 5 })).items
  } catch {
    recent = []
  }
}
const calendarWidget = visible.find((widget) => widget.type === 'calendar')
let calendarItems: BlogCalendarEntry[] = []
if (calendarWidget) {
  try {
    calendarItems = (await loadCalendar()).items
  } catch (cause) {
    console.warn('[blog] calendar data failed', cause)
  }
}
const profile = blog.site.profile
const socialLinks = profile.links.filter((link) => safeUrl(link.url))
const avatar = profile.avatar ? mediaUrl(profile.avatar) : null
const widgetTitle = (widget: (typeof all)[number]): string => {
  if (widget.title) return widget.title
  const keys: Record<string, string> = {
    profile: profile.name, search: t(locale, 'search.title'), categories: t(locale, 'nav.categories'),
    tags: t(locale, 'nav.tags'), series: t(locale, 'nav.series'), recent: t(locale, 'common.recentPosts'),
    stats: t(locale, 'common.stats'), calendar: t(locale, 'calendar.title'), announcement: '',
  }
  return keys[widget.type] ?? ''
}
const customHtml = (widget: (typeof all)[number]): string => typeof widget.config.html === 'string' ? widget.config.html : ''
const announcement = (widget: (typeof all)[number]): string => typeof widget.config.text === 'string' ? widget.config.text : ''
const siteAnnouncement = blog.site.announcement ?? { enable: false, text: '', closable: true }
const socialKind = (url: string, label: string): string => {
  const value = `${url} ${label}`.toLowerCase()
  if (/github/.test(value)) return 'github'
  if (/(^|[./])x\.com|twitter/.test(value)) return 'x'
  if (/weibo/.test(value)) return 'weibo'
  if (/linkedin/.test(value)) return 'linkedin'
  if (/bilibili|b23\.tv/.test(value)) return 'bilibili'
  if (/zhihu/.test(value)) return 'zhihu'
  if (/t\.me|telegram/.test(value)) return 'telegram'
  if (/^mailto:|email/.test(value)) return 'mail'
  if (/rss|atom|feed/.test(value)) return 'rss'
  return 'link'
}
const socialGlyph = (label: string): string => Array.from(label.trim())[0]?.toUpperCase() ?? '↗'

---

{(visible.length > 0 || (siteAnnouncement.enable && siteAnnouncement.text)) && (
  <aside class="sidebar" aria-label={t(locale, 'common.categories')}>
    {siteAnnouncement.enable && siteAnnouncement.text && (
      <section class="sidebar-card announcement-card" data-announcement={siteAnnouncement.text.slice(0, 120)}>
        <p class="profile-bio">{siteAnnouncement.text}</p>
        {siteAnnouncement.linkText && safeUrl(siteAnnouncement.linkUrl) && (
          <p class="announcement-link"><a class="chip" href={safeUrl(siteAnnouncement.linkUrl) ?? undefined} target="_blank" rel="noopener noreferrer">{siteAnnouncement.linkText}</a></p>
        )}
        {siteAnnouncement.closable && (
          <button type="button" class="announcement-close" data-announcement-close aria-label={t(locale, 'friends.close')} title={t(locale, 'friends.close')}>×</button>
        )}
      </section>
    )}
    {ordered.map((widget) => {
      if (widget.type === 'profile') return (profile.name || profile.bio || avatar || socialLinks.length > 0 || profile.email || profile.location) && (
        <section class:list={["sidebar-card profile-card", widget.slot === 'sticky' && 'sidebar-sticky']} aria-label={profile.name || t(locale, 'nav.about')}>
          {avatar
            ? <img class="profile-avatar" src={avatar} alt="" loading="lazy" />
            : <span class="profile-avatar profile-avatar--placeholder" aria-hidden="true">{Array.from(profile.name || '?')[0]?.toUpperCase() ?? '?'}</span>}
          {widgetTitle(widget) && <h2 class="profile-name">{widgetTitle(widget)}</h2>}
          {profile.bio && <p class="profile-bio">{profile.bio}</p>}
          {(profile.location || profile.email) && (
            <p class="profile-meta">
              {profile.location && <span title={t(locale, 'profile.location')}><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 21s7-5.5 7-12a7 7 0 1 0-14 0c0 6.5 7 12 7 12Z"/><circle cx="12" cy="9" r="2.5"/></svg>{profile.location}</span>}
              {profile.email && <a href={`mailto:${profile.email}`} title={t(locale, 'profile.email')}><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>{profile.email}</a>}
            </p>
          )}
          <div class="profile-social" aria-label={t(locale, 'profile.links')}>
            {socialLinks.map((link) => {
              const kind = socialKind(link.url, link.label)
              return (
                <a class="profile-social-btn" href={safeUrl(link.url) ?? '#'} target={link.url.startsWith('mailto:') ? undefined : '_blank'} rel="noopener noreferrer" title={link.label} aria-label={link.label}>
                  {kind === 'github' ? <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.15-1.1-1.46-1.1-1.46-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.88 1.52 2.31 1.08 2.87.83.09-.65.35-1.08.63-1.33-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/></svg> : kind === 'x' ? <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 2H22l-6.8 7.8L23.2 22h-6.3l-4.9-6.4L6.4 22H3.3l7.3-8.4L2.8 2h6.4l4.4 5.8L18.9 2Zm-1.1 17.9h1.7L7.9 4H6.1l11.7 15.9Z"/></svg> : kind === 'rss' ? <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg> : <span class="profile-social-glyph" aria-hidden="true">{kind === 'weibo' ? '微' : kind === 'linkedin' ? 'in' : kind === 'bilibili' ? 'B' : kind === 'zhihu' ? '知' : socialGlyph(link.label)}</span>}
                </a>
              )
            })}
            <a class="profile-social-btn" href="/rss.xml" target="_blank" rel="noopener noreferrer" title="RSS" aria-label="RSS">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
            </a>
            {profile.email && (
              <a class="profile-social-btn" href={`mailto:${profile.email}`} title={t(locale, 'profile.email')} aria-label={t(locale, 'profile.email')}>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
              </a>
            )}
          </div>
        </section>
      )
      if (widget.type === 'search') return (
        <section class:list={["sidebar-card", widget.slot === 'sticky' && 'sidebar-sticky']} aria-label={t(locale, 'search.title')}>
          <h2 class="sidebar-title">{widgetTitle(widget)}</h2>
          <form class="search-form" action="/search" method="get" role="search">
            <label class="sr-only" for="sidebar-search">{t(locale, 'search.placeholder')}</label>
            <input id="sidebar-search" type="search" name="q" placeholder={t(locale, 'search.placeholder')} />
            <button type="submit">{t(locale, 'search.title')}</button>
          </form>
        </section>
      )
      if (widget.type === 'categories' || widget.type === 'tags' || widget.type === 'series') {
        const items = widget.type === 'categories' ? blog.categories : widget.type === 'tags' ? blog.tags : blog.series
        const base = widget.type === 'categories' ? '/categories' : widget.type === 'tags' ? '/tags' : '/series'
        const key = widget.type === 'categories' ? 'nav.categories' : widget.type === 'tags' ? 'nav.tags' : 'nav.series'
        if (items.length === 0) return null
        const collapseAt = typeof widget.collapseAfter === 'number' && widget.collapseAfter > 0 ? widget.collapseAfter : 8
        const shown = items.slice(0, collapseAt)
        const rest = items.slice(collapseAt)
        const renderItem = (item: (typeof items)[number]) => (
          <li>
            <a href={`${base}/${encodeURIComponent(item.slug)}`}>
              <span>{item.name}</span>
              <span class="widget-count">{item.count}</span>
            </a>
          </li>
        )
        return (
          <section class:list={["sidebar-card", widget.slot === 'sticky' && 'sidebar-sticky']} aria-labelledby={`widget-${widget.id}`}>
            <h2 class="sidebar-title" id={`widget-${widget.id}`}>{widgetTitle(widget) || t(locale, key)}</h2>
            <ul class="widget-list">
              {shown.map(renderItem)}
              <li><a href={base}><span>{t(locale, 'common.readMore')}</span><Icon name="arrow-right" size={13} /></a></li>
            </ul>
            {rest.length > 0 && (
              <details class="widget-more">
                <summary>{t(locale, 'common.readMore')} ({rest.length})</summary>
                <ul class="widget-list">{rest.map(renderItem)}</ul>
              </details>
            )}
          </section>
        )
      }
      if (widget.type === 'recent') return (
        <section class:list={["sidebar-card", widget.slot === 'sticky' && 'sidebar-sticky']} aria-labelledby={`widget-${widget.id}`}>
          <h2 class="sidebar-title" id={`widget-${widget.id}`}>{widgetTitle(widget)}</h2>
          <ul class="widget-list">
            {recent.map((post) => (
              <li>
                <a href={`/posts/${encodeURIComponent(post.slug)}`}>
                  <span>{post.title || t(locale, 'common.untitled')}</span>
                  <Icon name="arrow-right" size={13} />
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
      if (widget.type === 'calendar') return (
        <section class:list={["sidebar-card", widget.slot === 'sticky' && 'sidebar-sticky']} aria-labelledby={`widget-${widget.id}`}>
          <h2 class="sidebar-title" id={`widget-${widget.id}`}>{widgetTitle(widget)}</h2>
          <CalendarWidget client:visible locale={locale} timeZone={blog.site.site.timeZone} items={calendarItems} />
        </section>
      )
      if (widget.type === 'stats') return (
        <section class:list={["sidebar-card", widget.slot === 'sticky' && 'sidebar-sticky']} aria-label={widgetTitle(widget) || t(locale, 'common.stats')}>
          <h2 class="sidebar-title">{widgetTitle(widget) || t(locale, 'common.stats')}</h2>
          <ul class="widget-list">
            <li><span>{t(locale, 'common.posts')}</span><span class="widget-count">{blog.site.counts.posts}</span></li>
            <li><span>{t(locale, 'common.categories')}</span><span class="widget-count">{blog.site.counts.categories}</span></li>
            <li><span>{t(locale, 'common.tags')}</span><span class="widget-count">{blog.site.counts.tags}</span></li>
            <li><span>{t(locale, 'common.series')}</span><span class="widget-count">{blog.site.counts.series}</span></li>
            <li><span>{t(locale, 'common.views')}</span><span class="widget-count">{blog.site.counts.views}</span></li>
          </ul>
        </section>
      )
      if (widget.type === 'announcement') {
        const text = announcement(widget)
        return text ? (
          <section class:list={["sidebar-card", widget.slot === 'sticky' && 'sidebar-sticky']} aria-label={widget.title || 'Announcement'}>
            {widget.title && <h2 class="sidebar-title">{widget.title}</h2>}
            <p class="profile-bio">{text}</p>
          </section>
        ) : null
      }
      if (widget.type === 'custom') {
        const html = customHtml(widget)
        return html ? (
          <section class:list={["sidebar-card", widget.slot === 'sticky' && 'sidebar-sticky']} aria-label={widget.title || 'Custom'}>
            {widget.title && <h2 class="sidebar-title">{widget.title}</h2>}
            <div set:html={html} />
          </section>
        ) : null
      }
      return null
    })}
  </aside>
)}

