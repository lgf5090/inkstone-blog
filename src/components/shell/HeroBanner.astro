---
import { blogLocale, t } from '../../i18n'
import { FALLBACK_SITE } from '../../server/site-config'
const blog = Astro.locals.blog ?? {
  site: FALLBACK_SITE,
  banner: { title: FALLBACK_SITE.site.title, subtitle: '', hue: 315, gradient: true, typewriter: true, waves: true, texture: true },
}
const locale = blogLocale(blog.site.site.locale)
const banner = blog.site.site.banner ?? { desktopLight: '', desktopDark: '', mobileLight: '', mobileDark: '' }
const cssUrl = (value: string) => value ? `url("${value.replace(/"/g, '%22')}")` : ''
const mediaVars = [
  banner.desktopLight ? `--banner-desktop:${cssUrl(banner.desktopLight)}` : '',
  banner.desktopDark ? `--banner-desktop-dark:${cssUrl(banner.desktopDark)}` : '',
  banner.mobileLight ? `--banner-mobile:${cssUrl(banner.mobileLight)}` : '',
  banner.mobileDark ? `--banner-mobile-dark:${cssUrl(banner.mobileDark)}` : '',
].filter(Boolean).join(';')
const hasBannerImage = Boolean(banner.desktopLight || banner.desktopDark || banner.mobileLight || banner.mobileDark)
---
<section class="hero-banner" aria-labelledby="hero-title" data-texture={blog.banner.texture ? '' : undefined} data-waves={blog.banner.waves ? '' : undefined}>
  {hasBannerImage && <div class="hero-media" data-hero-media style={mediaVars} aria-hidden="true"></div>}
  <div class="hero-inner">
    <span class="hero-eyebrow">{t(locale, 'nav.home')}</span>
    <h1 id="hero-title" class="hero-title">{blog.site.site.title}</h1>
    {blog.site.site.subtitle && (
      <p class="hero-subtitle" aria-label={blog.site.site.subtitle}>
        <span data-hero-typewriter data-full={blog.site.site.subtitle} data-animate={blog.banner.typewriter ? '' : undefined}>{blog.site.site.subtitle}</span>
      </p>
    )}
    <div class="hero-meta">
      <span>{blog.site.counts.posts} {t(locale, 'common.posts')}</span>
      <span>{blog.site.counts.tags} {t(locale, 'common.tags')}</span>
      <span>{blog.site.counts.categories} {t(locale, 'common.categories')}</span>
    </div>
  </div>
  <div class="hero-waves" aria-hidden="true">
    <svg viewBox="0 0 1440 92" preserveAspectRatio="none" focusable="false"><path d="M0,52 C220,92 420,8 720,42 C980,71 1180,34 1440,56 L1440,92 L0,92 Z" /></svg>
    <svg viewBox="0 0 1440 92" preserveAspectRatio="none" focusable="false"><path d="M0,66 C260,36 460,82 760,58 C1040,36 1220,70 1440,46 L1440,92 L0,92 Z" /></svg>
  </div>
</section>
<script is:inline data-astro-rerun>
  (() => {
    const target = document.querySelector('[data-hero-typewriter]')
    if (!target || !target.hasAttribute('data-animate')) return
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return
    const text = target.getAttribute('data-full') || target.textContent || ''
    target.textContent = ''
    let index = 0
    const timer = window.setInterval(() => {
      target.textContent = text.slice(0, ++index)
      if (index >= text.length) window.clearInterval(timer)
    }, 42)
    window.__blogRegisterCleanup?.('banner', () => window.clearInterval(timer))
  })()
</script>
