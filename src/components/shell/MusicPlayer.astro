---
import { blogLocale, t } from '../../i18n'
import { FALLBACK_SITE } from '../../server/site-config'
import type { BlogMusicConfig } from '../../lib/blog-types'
import BlogMusicPlayer from './BlogMusicPlayer.svelte'

const blog = Astro.locals.blog ?? {
  site: FALLBACK_SITE,
  music: { enabled: false, provider: 'none', tracks: [], defaultVolume: 0.7, defaultMode: 'sequence' } as BlogMusicConfig,
  runtimeVersion: 'inkstone-blog-v3',
}
const locale = blogLocale(blog.site.site.locale)
const music = blog.music ?? { enabled: false, provider: 'none', tracks: [], defaultVolume: 0.7, defaultMode: 'sequence' } as BlogMusicConfig
// A provider is the owner's decision; playability is what the projection could actually validate.
// The two differ when a provider is chosen but no track survived the public filter, and that state
// must still be reachable instead of the button vanishing without a word.
const configured = music.provider !== 'none'
const labels = {
  title: t(locale, 'music.title'),
  play: t(locale, 'music.play'),
  pause: t(locale, 'music.pause'),
  previous: t(locale, 'music.previous'),
  next: t(locale, 'music.next'),
  rewind: t(locale, 'music.rewind'),
  forward: t(locale, 'music.forward'),
  mode: t(locale, 'music.mode'),
  modeSequence: t(locale, 'music.modeSequence'),
  modeRepeatOne: t(locale, 'music.modeRepeatOne'),
  modeShuffle: t(locale, 'music.modeShuffle'),
  progress: t(locale, 'music.progress'),
  volume: t(locale, 'music.volume'),
  mute: t(locale, 'music.mute'),
  unmute: t(locale, 'music.unmute'),
  playlist: t(locale, 'music.playlist'),
  empty: t(locale, 'music.empty'),
  loading: t(locale, 'music.loading'),
  error: t(locale, 'music.error'),
  nowPlaying: t(locale, 'music.nowPlaying'),
  configure: t(locale, 'music.configure'),
  queueSearch: t(locale, 'music.queueSearch'),
  queueEmpty: t(locale, 'music.queueEmpty'),
  queueNoMatch: t(locale, 'music.queueNoMatch'),
  rate: t(locale, 'music.rate'),
  close: t(locale, 'music.close'),
  minimize: t(locale, 'music.minimize'),
  expand: t(locale, 'music.expand'),
  lyricsEmpty: t(locale, 'music.lyricsEmpty'),
  drag: t(locale, 'music.drag'),
}
const emptyMessage = music.provider === 'library' ? libraryEmptyMessage(music.libraryStatus) : labels.configure
const options = { music, labels, locale, emptyMessage }

function libraryEmptyMessage(status: BlogMusicConfig['libraryStatus']): string {
  switch (status) {
    case 'no-r2': return t(locale, 'music.libraryNoR2')
    case 'playlist-empty': return t(locale, 'music.libraryPlaylistEmpty')
    case 'playlist-missing': return t(locale, 'music.libraryPlaylistMissing')
    case 'signing-unavailable': return t(locale, 'music.libraryUnavailable')
    default: return t(locale, 'music.libraryEmpty')
  }
}
---
{configured && <BlogMusicPlayer client:load options={options} />}
