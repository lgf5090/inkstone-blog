---
import { blogLocale, t } from '../../i18n'
import { FALLBACK_SITE } from '../../server/site-config'
import type { BlogMusicConfig } from '../../lib/blog-types'

const blog = Astro.locals.blog ?? {
  site: FALLBACK_SITE,
  music: { enabled: false, provider: 'none', tracks: [], defaultVolume: 0.7, defaultMode: 'sequence' } as BlogMusicConfig,
  runtimeVersion: 'inkstone-blog-v3',
}
const locale = blogLocale(blog.site.site.locale)
const music = blog.music ?? { enabled: false, provider: 'none', tracks: [], defaultVolume: 0.7, defaultMode: 'sequence' } as BlogMusicConfig
const runtimeVersion = blog.runtimeVersion ?? 'inkstone-blog-v3'
const runtimeOrigin = (import.meta.env.BLOG_RUNTIME_ORIGIN || import.meta.env.BLOG_API_ORIGIN || '').replace(/\/+$/, '')
const runtimeUrl = import.meta.env.DEV
  ? (runtimeOrigin ? `${runtimeOrigin}/src/blog-runtime/music.tsx` : '')
  : `/_blog/runtime/${encodeURIComponent(runtimeVersion)}/music/music.js`
const runtimeCss = import.meta.env.DEV ? '' : `/_blog/runtime/${encodeURIComponent(runtimeVersion)}/music/music.css`
const labels = {
  title: t(locale, 'music.title'),
  play: t(locale, 'music.play'),
  pause: t(locale, 'music.pause'),
  previous: t(locale, 'music.previous'),
  next: t(locale, 'music.next'),
  mode: t(locale, 'music.mode'),
  modeSequence: t(locale, 'music.modeSequence'),
  modeRepeatOne: t(locale, 'music.modeRepeatOne'),
  modeShuffle: t(locale, 'music.modeShuffle'),
  progress: t(locale, 'music.progress'),
  volume: t(locale, 'music.volume'),
  mute: t(locale, 'music.mute'),
  unmute: t(locale, 'music.unmute'),
  playlist: t(locale, 'music.playlist'),
  empty: t(locale, 'music.empty'),
  loading: t(locale, 'music.loading'),
  error: t(locale, 'music.error'),
  nowPlaying: t(locale, 'music.nowPlaying'),
}
const options = { music, labels }
---
{music.enabled && runtimeUrl && (
  <section class="sidebar-card music-card" aria-label={labels.title} data-blog-music data-runtime-url={runtimeUrl} data-runtime-css={runtimeCss} data-dev-origin={import.meta.env.DEV ? runtimeOrigin : ''} data-options={JSON.stringify(options)}>
    <h2 class="sidebar-title">{labels.title}</h2>
    <div data-blog-music-mount>
      <p class="blog-music__status">{labels.loading}</p>
    </div>
    <script is:inline data-astro-rerun>
      (() => {
        const card = document.querySelector('[data-blog-music]')
        if (!card) return
        const mount = card.querySelector('[data-blog-music-mount]')
        const runtimeUrl = card.getAttribute('data-runtime-url')
        let options = null
        try {
          options = JSON.parse(card.getAttribute('data-options') || '{}')
        } catch {
          options = null
        }
        if (!mount || !runtimeUrl || !options) return
        const devOrigin = card.getAttribute('data-dev-origin') || ''
        let cancelled = false
        let playerHandle = null
        window.__blogRegisterCleanup?.('music', () => {
          cancelled = true
          try {
            playerHandle?.unmount()
          } catch (error) {
            console.warn('[blog] music player cleanup failed', error)
          }
        })
        const fail = (error) => {
          mount.textContent = options.labels.error
          console.warn('[blog] music player unavailable', error)
        }
        const boot = async () => {
          if (cancelled || !document.contains(card)) return
          try {
            if (devOrigin) {
              const refresh = await import(devOrigin + '/@react-refresh')
              refresh.injectIntoGlobalHook(window)
              window.$RefreshReg$ = () => {}
              window.$RefreshSig$ = () => (type) => type
              window.__vite_plugin_react_preamble_installed__ = true
            }
            const css = card.getAttribute('data-runtime-css')
            if (css && !document.querySelector('link[data-blog-music-style]')) {
              const link = document.createElement('link')
              link.rel = 'stylesheet'
              link.href = css
              link.setAttribute('data-blog-music-style', '')
              document.head.appendChild(link)
            }
            await import(runtimeUrl)
          } catch (error) {
            fail(error)
            return
          }
          const api = window.InkstoneBlogMusic
          if (!api) {
            fail(new Error('music runtime missing'))
            return
          }
          if (cancelled || !document.contains(card)) return
          try {
            playerHandle = await api.mount({ container: mount, music: options.music, labels: options.labels })
            if (cancelled) playerHandle.unmount()
          } catch (error) {
            fail(error)
          }
        }
        if (typeof window.requestIdleCallback === 'function') window.requestIdleCallback(boot, { timeout: 2500 })
        else window.setTimeout(boot, 200)
      })()
    </script>
  </section>
)}
