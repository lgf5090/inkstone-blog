---
import Icon from '../Icon.astro'
import AppearanceMenu from './AppearanceMenu.svelte'
import { blogLocale, t, LOCALES, LOCALE_LABELS, type MessageKey } from '../../i18n'
import { safeUrl } from '../../lib/format'
import { FALLBACK_SITE } from '../../server/site-config'

interface Props {
  activePath?: string
}
const blog = Astro.locals.blog ?? { site: FALLBACK_SITE }
const locale = blogLocale(blog.site.site.locale)
const pathname = Astro.props.activePath ?? Astro.url.pathname
const links = blog.site.nav.length ? blog.site.nav : [{ label: t(locale, 'nav.home'), href: '/' }]
const hrefOf = (href: string): string => safeUrl(href) ?? '/'
const isActive = (href: string): boolean => href === '/'
  ? pathname === '/' || pathname.startsWith('/page/')
  : pathname === href || pathname.startsWith(`${href.replace(/\/$/, '')}/`)
const languageHref = (code: string): string => {
  const target = new URL(Astro.url)
  target.searchParams.set('lang', code)
  return `${target.pathname}${target.search}`
}
const labelKey = (href: string): MessageKey | null => {
  const map: Record<string, MessageKey> = {
    '/': 'nav.home', '/archive': 'nav.archive', '/categories': 'nav.categories', '/tags': 'nav.tags',
    '/series': 'nav.series', '/friends': 'nav.friends', '/moments': 'nav.moments', '/albums': 'nav.albums',
    '/projects': 'nav.projects', '/skills': 'nav.skills', '/devices': 'nav.devices', '/games': 'nav.games',
    '/anime': 'nav.anime', '/timeline': 'nav.timeline', '/compass': 'nav.compass', '/about': 'nav.about',
    '/search': 'nav.search', '/more': 'nav.more',
  }
  return map[href.replace(/\/$/, '') || '/'] ?? null
}
const fallbackLabel = (href: string, label: string): string => labelKey(href) ? t(locale, labelKey(href)!) : label
type NavIconName = 'home' | 'archive' | 'link' | 'sparkles' | 'tv' | 'compass' | 'photo' | 'apps'
const iconByHref: Record<string, NavIconName> = {
  '/': 'home', '/archive': 'archive', '/friends': 'link', '/moments': 'sparkles',
  '/anime': 'tv', '/compass': 'compass', '/albums': 'photo', '/more': 'apps',
}
const iconFor = (href: string): NavIconName | null => iconByHref[href.replace(/\/$/, '') || '/'] ?? null
const groupActive = (item: { href: string; children?: { href: string }[] }): boolean =>
  isActive(item.href) || Boolean(item.children?.some((child) => isActive(child.href)))
const permalinkEnabled = Boolean(blog.site.permalink?.enable)
const searchLabels = {
  empty: t(locale, 'search.empty'),
  loading: t(locale, 'search.loading'),
  error: t(locale, 'search.error'),
}
---

<header class="top-app-bar">
  <div class="top-app-bar-inner">
    <a href="/" class="brand" aria-label={blog.site.site.title}>
      <span class="brand-mark" aria-hidden="true">
        <Icon name="sparkles" size={17} />
      </span>
      <span class="brand-text">
        <span class="brand-title">{blog.site.site.title}</span>
        {blog.site.site.subtitle && <span class="brand-subtitle">{blog.site.site.subtitle}</span>}
      </span>
    </a>

    <nav class="top-nav" aria-label={t(locale, 'nav.home')}>
      {links.map((item) => (
        item.children?.length ? (
          <details class="nav-menu">
            <summary class="nav-link" aria-current={groupActive(item) ? 'page' : undefined}>
              {iconFor(item.href) && <Icon name={iconFor(item.href)!} size={13} />}
              {fallbackLabel(item.href, item.label)}
            </summary>
            <div class="nav-menu-panel">
              {item.children.map((child) => (
                <a href={hrefOf(child.href)} aria-current={isActive(child.href) ? 'page' : undefined}>
                  {iconFor(child.href) && <Icon name={iconFor(child.href)!} size={13} />}
                  {fallbackLabel(child.href, child.label)}
                </a>
              ))}
            </div>
          </details>
        ) : (
          <a
            href={hrefOf(item.href)}
            class="nav-link"
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {iconFor(item.href) && <Icon name={iconFor(item.href)!} size={13} />}
            {fallbackLabel(item.href, item.label)}
          </a>
        )
      ))}
    </nav>

    <div class="top-actions">
      <button type="button" class="icon-button" data-search-open aria-label={t(locale, 'search.title')} title={t(locale, 'search.title')}>
        <Icon name="search" size={17} />
      </button>
      <details class="nav-menu mobile-menu">
        <summary class="icon-button" aria-label={t(locale, 'nav.more')} title={t(locale, 'nav.more')}>
          <Icon name="menu" size={17} />
        </summary>
        <div class="nav-menu-panel mobile-menu-panel">
          <nav class="mobile-nav" aria-label={t(locale, 'nav.home')}>
            {links.map((item) => (
              item.children?.length ? (
                <details class="mobile-nav-group">
                  <summary class="nav-link" aria-current={groupActive(item) ? 'page' : undefined}>
                    {iconFor(item.href) && <Icon name={iconFor(item.href)!} size={13} />}
                    {fallbackLabel(item.href, item.label)}
                  </summary>
                  <div class="mobile-nav-children">
                    {item.children.map((child) => (
                      <a href={hrefOf(child.href)} aria-current={isActive(child.href) ? 'page' : undefined}>{fallbackLabel(child.href, child.label)}</a>
                    ))}
                  </div>
                </details>
              ) : (
                <a href={hrefOf(item.href)} class="nav-link" aria-current={isActive(item.href) ? 'page' : undefined}>
                  {iconFor(item.href) && <Icon name={iconFor(item.href)!} size={13} />}
                  {fallbackLabel(item.href, item.label)}
                </a>
              )
            ))}
            <button type="button" class="nav-link" data-search-open>{t(locale, 'nav.search')}</button>
          </nav>
        </div>
      </details>
      <details class="nav-menu lang-menu">
        <summary class="icon-button" aria-label={t(locale, 'common.language')} title={t(locale, 'common.language')}>文</summary>
        <div class="nav-menu-panel lang-panel">
          {LOCALES.map((code) => (
            <a href={languageHref(code)} aria-current={code === locale ? 'true' : undefined}>{LOCALE_LABELS[code]}</a>
          ))}
        </div>
      </details>
      <AppearanceMenu
        client:idle
        locale={locale}
      />
    </div>
  </div>

  <div class="search-overlay" data-search-overlay data-permalink-enabled={permalinkEnabled ? 'true' : 'false'} data-search-labels={JSON.stringify(searchLabels)} hidden>
    <div class="search-dialog" role="dialog" aria-modal="true" aria-labelledby="search-dialog-title">
      <h2 id="search-dialog-title" class="sr-only">{t(locale, 'search.title')}</h2>
      <form class="search-dialog-form" role="search" data-search-form>
        <label class="sr-only" for="instant-search-input">{t(locale, 'search.placeholder')}</label>
        <input id="instant-search-input" type="search" data-search-input placeholder={t(locale, 'search.placeholder')} autocomplete="off" />
        <button type="button" class="icon-button" data-search-close aria-label={t(locale, 'search.close')} title={t(locale, 'search.close')}>×</button>
      </form>
      <p class="search-dialog-status" data-search-status aria-live="polite"></p>
      <ul class="search-dialog-results" data-search-results></ul>
      <a class="chip" href="/search" data-search-more>{t(locale, 'search.viewAll')}</a>
    </div>
  </div>
</header>
<script is:inline data-astro-rerun>
  (() => {
    const overlay = document.querySelector('[data-search-overlay]')
    if (!overlay) return
    const input = overlay.querySelector('[data-search-input]')
    const list = overlay.querySelector('[data-search-results]')
    const status = overlay.querySelector('[data-search-status]')
    const more = overlay.querySelector('[data-search-more]')
    const searchLabels = JSON.parse(overlay.getAttribute('data-search-labels') || '{}')
    const permalinkEnabled = overlay.getAttribute('data-permalink-enabled') === 'true'
    let opener = null
    let timer = 0
    let controller = null
    let inerted = []
    const setBackgroundInert = (on) => {
      if (on) {
        let node = overlay
        while (node && node !== document.body) {
          const parent = node.parentElement
          if (!parent) break
          for (const sibling of parent.children) {
            if (sibling === node || !(sibling instanceof HTMLElement)) continue
            inerted.push({ element: sibling, was: sibling.inert })
            sibling.inert = true
          }
          node = parent
        }
      } else {
        for (const entry of inerted) entry.element.inert = entry.was
        inerted = []
      }
    }
    const close = () => {
      if (overlay.hidden) return
      overlay.hidden = true
      setBackgroundInert(false)
      document.documentElement.style.removeProperty('overflow')
      opener?.focus()
      opener = null
    }
    const open = (event) => {
      opener = event.currentTarget
      overlay.hidden = false
      setBackgroundInert(true)
      document.documentElement.style.overflow = 'hidden'
      input.focus()
      if (input.value.trim()) void run(input.value.trim())
    }
    const postHref = (item) => {
      if (permalinkEnabled && item.permalink) {
        const path = item.permalink.trim().replace(/^\/+|\/+$/g, '')
        if (path && !path.includes('..')) return '/' + path.split('/').map(encodeURIComponent).join('/')
      }
      return '/posts/' + encodeURIComponent(item.slug)
    }
    const render = (items) => {
      list.replaceChildren()
      status.textContent = items.length === 0 ? searchLabels.empty : ''
      for (const item of items) {
        const li = document.createElement('li')
        const link = document.createElement('a')
        link.href = postHref(item)
        const title = document.createElement('strong')
        title.textContent = item.title
        const excerpt = document.createElement('span')
        excerpt.textContent = item.excerpt || item.category || ''
        link.append(title, excerpt)
        li.append(link)
        list.append(li)
      }
    }
    const run = async (query) => {
      controller?.abort()
      if (!query) {
        list.replaceChildren()
        status.textContent = ''
        return
      }
      status.textContent = searchLabels.loading
      controller = new AbortController()
      try {
        const response = await fetch('/_blog/search?q=' + encodeURIComponent(query), { signal: controller.signal })
        if (response.status === 429) {
          list.replaceChildren()
          status.textContent = searchLabels.error
          return
        }
        const data = await response.json()
        render(Array.isArray(data.items) ? data.items : [])
      } catch (error) {
        if (error?.name !== 'AbortError') {
          console.warn('[blog] instant search failed', error)
          status.textContent = searchLabels.error
        }
      }
    }
    input.addEventListener('input', () => {
      clearTimeout(timer)
      const query = input.value.trim()
      more.href = '/search' + (query ? '?q=' + encodeURIComponent(query) : '')
      timer = window.setTimeout(() => void run(query), 220)
    })
    overlay.addEventListener('click', (event) => {
      if (event.target === overlay) close()
    })
    overlay.querySelector('[data-search-close]')?.addEventListener('click', close)
    document.querySelectorAll('[data-search-open]').forEach((button) => button.addEventListener('click', open))
    overlay.querySelector('[data-search-form]')?.addEventListener('submit', (event) => {
      event.preventDefault()
      const query = input.value.trim()
      location.href = '/search' + (query ? '?q=' + encodeURIComponent(query) : '')
    })
    const onKey = (event) => {
      if (event.key === 'Escape') close()
      if (!overlay.hidden && event.key === 'Tab') {
        const focusables = [...overlay.querySelectorAll('a[href], button:not([disabled]), input:not([disabled])')]
        if (focusables.length > 0) {
          const first = focusables[0]
          const last = focusables[focusables.length - 1]
          if (!overlay.contains(document.activeElement)) {
            event.preventDefault()
            first.focus()
          } else if (event.shiftKey && document.activeElement === first) {
            event.preventDefault()
            last.focus()
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault()
            first.focus()
          }
        }
        return
      }
      if (overlay.hidden || (event.key !== 'ArrowDown' && event.key !== 'ArrowUp')) return
      const links = [...list.querySelectorAll('a')]
      if (links.length === 0) return
      event.preventDefault()
      const index = links.indexOf(document.activeElement)
      const next = event.key === 'ArrowDown' ? (index + 1) % links.length : (index - 1 + links.length) % links.length
      links[next]?.focus()
    }
    document.addEventListener('keydown', onKey)
    window.__blogRegisterCleanup?.('instant-search', () => {
      controller?.abort()
      clearTimeout(timer)
      setBackgroundInert(false)
      document.removeEventListener('keydown', onKey)
    })
  })()
</script>
