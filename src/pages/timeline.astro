---
import Layout from '../layouts/Layout.astro'
import MainGridLayout from '../layouts/MainGridLayout.astro'
import TimelineSection from '../components/blog/TimelineSection.svelte'
import { blogLocale, pickMessages, t } from '../i18n'
import { loadCollection, userFacingError } from '../lib/blog-api'
import type { BlogCollectionItem } from '../lib/blog-types'
import { FALLBACK_SITE } from '../server/site-config'

const blog = Astro.locals.blog ?? { site: FALLBACK_SITE }
const locale = blogLocale(blog.site.site.locale)
let items: BlogCollectionItem[] = []
let error = ''
try { items = (await loadCollection('timeline')).items } catch (cause) { error = userFacingError(cause, t(locale, 'common.loadError')) }
---
<Layout title={t(locale, 'nav.timeline')}>
  <MainGridLayout page="timeline">
    {error ? (
      <div class="error-state" role="alert"><strong>{t(locale, 'common.loadError')}</strong><p>{error}</p></div>
    ) : (
      <TimelineSection
        {items}
        {locale}
        messages={pickMessages(locale, ['collections.all', 'collections.noResults', 'nav.timeline'])}
        client:visible
      />
    )}
  </MainGridLayout>
</Layout>
