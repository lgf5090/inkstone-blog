---
import { resolvePostPermalink, resolveRedirect } from '../lib/blog-api'
import { safeRedirectTarget } from '../lib/format'

const path = Astro.url.pathname
const redirect = await resolveRedirect(path).catch(() => ({ found: false } as import('../lib/blog-types').BlogRedirectResult))
if (redirect.found && redirect.to) {
  const target = safeRedirectTarget(redirect.to, Astro.url.origin)
  if (target) return Astro.redirect(target, (redirect.status ?? 301) as 301 | 302)
}
const permalink = await resolvePostPermalink(path).catch(() => null)
if (permalink?.found && permalink.slug) return Astro.rewrite(`/posts/${encodeURIComponent(permalink.slug)}`)
return Astro.rewrite('/404')
---
