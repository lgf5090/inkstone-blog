---
import Layout from '../layouts/Layout.astro'
import MainGridLayout from '../layouts/MainGridLayout.astro'
import CollectionGrid from '../components/blog/CollectionGrid.svelte'
import { blogLocale, t } from '../i18n'
import { loadCollection, userFacingError } from '../lib/blog-api'
import type { BlogCollectionItem } from '../lib/blog-types'
import { FALLBACK_SITE } from '../server/site-config'

const blog = Astro.locals.blog ?? { site: FALLBACK_SITE }
const locale = blogLocale(blog.site.site.locale)
let items: BlogCollectionItem[] = []
let error = ''
try { items = (await loadCollection('skills')).items } catch (cause) { error = userFacingError(cause, t(locale, 'common.loadError')) }
---
<Layout title={t(locale, 'nav.skills')}>
  <MainGridLayout page="skills">
    {error ? (
      <div class="error-state" role="alert"><strong>{t(locale, 'common.loadError')}</strong><p>{error}</p></div>
    ) : (
      <CollectionGrid kind="skills" {items} {locale} client:visible />
    )}
  </MainGridLayout>
</Layout>
