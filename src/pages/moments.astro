---
import Layout from '../layouts/Layout.astro'
import MainGridLayout from '../layouts/MainGridLayout.astro'
import MomentFeed from '../components/blog/MomentFeed.svelte'
import { blogLocale, pickMessages, t } from '../i18n'
import { loadCollection, userFacingError } from '../lib/blog-api'
import type { BlogCollectionItem } from '../lib/blog-types'
import { FALLBACK_SITE } from '../server/site-config'

const blog = Astro.locals.blog ?? { site: FALLBACK_SITE }
const locale = blogLocale(blog.site.site.locale)
let items: BlogCollectionItem[] = []
let error = ''
try { items = (await loadCollection('moments')).items } catch (cause) { error = userFacingError(cause, t(locale, 'common.loadError')) }
const author = {
  name: blog.site.profile?.name || blog.site.site.title,
  avatar: blog.site.profile?.avatar || '',
}
---
<Layout title={t(locale, 'nav.moments')}>
  <MainGridLayout page="moments">
    {error ? (
      <div class="error-state" role="alert"><strong>{t(locale, 'common.loadError')}</strong><p>{error}</p></div>
    ) : (
      <MomentFeed
        items={items}
        {locale}
        timeZone={blog.site.site.timeZone}
        {author}
        messages={pickMessages(locale, ['collections.all', 'collections.empty', 'collections.loadMore', 'collections.noResults', 'collections.search', 'common.photos', 'common.pinned', 'common.tags', 'friends.close', 'friends.open', 'nav.moments', 'common.previous', 'common.next'])}
        client:visible
      />
    )}
  </MainGridLayout>
</Layout>
