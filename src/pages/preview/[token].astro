---
import Layout from '../../layouts/Layout.astro'
import MainGridLayout from '../../layouts/MainGridLayout.astro'
import Icon from '../../components/Icon.astro'
import '../../styles/reading.css'
import '../../styles/feature-preview.css'
import { blogLocale, t } from '../../i18n'
import { BlogApiError, loadPreview, mediaUrl, userFacingError } from '../../lib/blog-api'
import { renderPageMarkdown } from '../../lib/markdown'
import { formatDate } from '../../lib/format'
import type { BlogPreviewDetail } from '../../lib/blog-types'
import { FALLBACK_SITE } from '../../server/site-config'

const blog = Astro.locals.blog ?? { site: FALLBACK_SITE, display: { tocDepth: 3 } }
const locale = blogLocale(blog.site.site.locale)
const token = Astro.params.token ?? ''
// A preview is a private reading surface: no search engine, no shared cache, and no view count.
Astro.response.headers.set('Cache-Control', 'no-store')
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow')
let preview: BlogPreviewDetail | null = null
let error = ''
let notFound = false
try {
  preview = await loadPreview(token)
} catch (cause) {
  if (cause instanceof BlogApiError && cause.status === 404) {
    notFound = true
    Astro.response.status = 404
  } else {
    error = userFacingError(cause, t(locale, 'preview.unavailable'))
  }
}
const cover = mediaUrl(preview?.coverUrl ?? null)
const bodyHtml = preview ? renderPageMarkdown(preview.content) : ''
const normalizeHeadingText = (value: string): string => value
  .replace(/<[^>]*>/g, '')
  .replace(/&nbsp;/gi, ' ')
  .replace(/&amp;/gi, '&')
  .replace(/&lt;/gi, '<')
  .replace(/&gt;/gi, '>')
  .replace(/&quot;/gi, '"')
  .replace(/&#39;/gi, "'")
  .replace(/\s+/g, ' ')
  .trim()
// The article page drops the note's own title heading when it repeats the page title; a preview
// reuses that layout, so it must not print the title twice either.
const leadingHeading = /^\s*<h1\b[^>]*>([\s\S]*?)<\/h1>\s*/i.exec(bodyHtml)
const html = preview && leadingHeading && normalizeHeadingText(leadingHeading[1]) === normalizeHeadingText(preview.title)
  ? bodyHtml.replace(/^\s*<h1\b[^>]*>[\s\S]*?<\/h1>\s*/i, '')
  : bodyHtml
const updated = preview?.updatedAt ? formatDate(preview.updatedAt, locale, blog.site.site.timeZone) : ''
---

<Layout
  title={preview ? `${t(locale, 'preview.badge')} · ${preview.title || t(locale, 'common.untitled')}` : t(locale, 'preview.invalid')}
  description={preview?.description || preview?.excerpt}
  noIndex
  type="article"
>
  <MainGridLayout page="preview">
    {notFound ? (
      <div class="error-state" role="alert">
        <strong>{t(locale, 'preview.invalid')}</strong>
        <p>{t(locale, 'preview.notice')}</p>
        <a class="chip" href="/">{t(locale, 'common.backHome')}</a>
      </div>
    ) : error || !preview ? (
      <div class="error-state" role="alert">
        <strong>{t(locale, 'preview.unavailable')}</strong>
        <p>{error}</p>
        <a class="chip" href="/">{t(locale, 'common.backHome')}</a>
      </div>
    ) : (
      <>
        <div class="preview-banner" role="status">
          <span class="preview-badge"><Icon name="sparkles" size={12} />{t(locale, 'preview.badge')}</span>
          <p>{t(locale, 'preview.notice')}</p>
        </div>
        <article class="article-shell" aria-labelledby="preview-title">
          <header class="article-header">
            <h1 id="preview-title" class="article-title">{preview.title || t(locale, 'common.untitled')}</h1>
            <div class="article-meta">
              {updated && <span>{t(locale, 'preview.updated')} {updated}</span>}
              <span>{preview.readingMinutes} {t(locale, 'common.minRead')}</span>
              {preview.category && <span>{preview.category}</span>}
            </div>
            {preview.tags.length > 0 && (
              <div class="post-card-tags" aria-label={t(locale, 'common.tags')}>
                {preview.tags.map((tag) => <span class="chip">#{tag}</span>)}
              </div>
            )}
            {preview.encrypted && <p class="preview-protected">{t(locale, 'preview.protected')}</p>}
          </header>
          {cover && <img class="article-cover" src={cover} alt="" loading="eager" decoding="async" />}
          <div class="article-body">
            <div class="ink-prose" set:html={html} />
          </div>
        </article>
        <a class="chip preview-back" href="/">{t(locale, 'common.backHome')}</a>
      </>
    )}
  </MainGridLayout>
</Layout>
