---
import Layout from '../layouts/Layout.astro'
import MainGridLayout from '../layouts/MainGridLayout.astro'
import FriendsSection from '../components/blog/FriendsSection.svelte'
import { blogLocale, t } from '../i18n'
import { loadFriends, userFacingError } from '../lib/blog-api'
import type { BlogFriends } from '../lib/blog-types'
import { FALLBACK_SITE } from '../server/site-config'

const blog = Astro.locals.blog ?? { site: FALLBACK_SITE }
const locale = blogLocale(blog.site.site.locale)
let friends: BlogFriends | null = null
let error = ''
try { friends = await loadFriends() } catch (cause) { error = userFacingError(cause, t(locale, 'common.loadError')) }
---
<Layout title={t(locale, 'nav.friends')}>
  <MainGridLayout page="friends">
    {error || !friends ? (
      <div class="error-state" role="alert">
        <strong>{t(locale, 'common.loadError')}</strong>
        <p>{error}</p>
        <a class="chip" href="/">{t(locale, 'common.backHome')}</a>
      </div>
    ) : (
      <FriendsSection {friends} {locale} client:visible />
    )}
  </MainGridLayout>
</Layout>
