---
import Layout from '../layouts/Layout.astro'
import MainGridLayout from '../layouts/MainGridLayout.astro'
import CompassSection from '../components/blog/CompassSection.svelte'
import { blogLocale, t } from '../i18n'
import { loadCompass, userFacingError } from '../lib/blog-api'
import type { BlogCompassShelf } from '../lib/blog-types'
import { FALLBACK_SITE } from '../server/site-config'

const blog = Astro.locals.blog ?? { site: FALLBACK_SITE }
const locale = blogLocale(blog.site.site.locale)
let shelves: BlogCompassShelf[] = []
let error = ''
try { shelves = (await loadCompass()).items } catch (cause) { error = userFacingError(cause, t(locale, 'common.loadError')) }
---
<Layout title={t(locale, 'nav.compass')}>
  <MainGridLayout page="compass">
    {error ? (
      <div class="error-state" role="alert"><strong>{t(locale, 'common.loadError')}</strong><p>{error}</p></div>
    ) : (
      <CompassSection {shelves} {locale} client:visible />
    )}
  </MainGridLayout>
</Layout>
