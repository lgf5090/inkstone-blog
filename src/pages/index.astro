---
import Layout from '../layouts/Layout.astro'
import MainGridLayout from '../layouts/MainGridLayout.astro'
import PostCard from '../components/blog/PostCard.astro'
import Pagination from '../components/blog/Pagination.astro'
import { blogLocale, t } from '../i18n'
import { BlogApiError, loadPosts } from '../lib/blog-api'
import type { BlogPage, BlogPostSummary } from '../lib/blog-types'
import { FALLBACK_SITE } from '../server/site-config'

const blog = Astro.locals.blog ?? { site: FALLBACK_SITE, display: { pageSize: 10, postListMode: 'list' as const } }
const locale = blogLocale(blog.site.site.locale)
const limit = blog.display.pageSize
let page: BlogPage<BlogPostSummary> | null = null
let error = Astro.locals.blogError ?? ''
try {
  page = await loadPosts({ page: 1, limit })
} catch (cause) {
  error = cause instanceof BlogApiError ? cause.message : t(locale, 'common.loadError')
}
const posts = page?.items ?? []
const mode = blog.display.postListMode
const siteUrl = (import.meta.env.BLOG_SITE_URL ?? Astro.url.origin).replace(/\/+$/, '')
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: blog.site.site.title,
  description: blog.site.site.description,
  url: siteUrl,
}
---

<Layout
  title={undefined}
  description={blog.site.site.description}
  jsonLd={jsonLd}
>
  <MainGridLayout page="home" hero>
    <section aria-labelledby="posts-heading">
      <div class="section-heading">
        <div>
          <h1 id="posts-heading">{t(locale, 'common.latest')}</h1>
          <p>{blog.site.counts.posts} {t(locale, 'common.posts')}</p>
        </div>
        <a class="chip" href="/archive">{t(locale, 'nav.archive')}</a>
      </div>

      {error ? (
        <div class="error-state" role="alert">
          <strong>{t(locale, 'common.loadError')}</strong>
          <p>{error}</p>
          <a class="chip" href={Astro.url.pathname}>{t(locale, 'common.retry')}</a>
        </div>
      ) : posts.length === 0 ? (
        <div class="empty-state">{t(locale, 'common.noPosts')}</div>
      ) : (
        <div class="post-list" data-mode={mode}>
          {posts.map((post) => <PostCard post={post} mode={mode} />)}
        </div>
      )}

      {page && page.total > 0 && (
        <Pagination page={page.page} total={page.total} limit={page.limit} />
      )}
    </section>
  </MainGridLayout>
</Layout>
