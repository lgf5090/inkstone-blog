---
import Layout from '../layouts/Layout.astro'
import MainGridLayout from '../layouts/MainGridLayout.astro'
import PostCard from '../components/blog/PostCard.astro'
import Pagination from '../components/blog/Pagination.astro'
import { blogLocale, t } from '../i18n'
import { BlogApiError, searchPosts } from '../lib/blog-api'
import type { BlogSearchResult } from '../lib/blog-types'
import { FALLBACK_SITE } from '../server/site-config'

const blog = Astro.locals.blog ?? { site: FALLBACK_SITE, display: { postListMode: 'list' as const } }
const locale = blogLocale(blog.site.site.locale)
const q = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 200)
const pageNumber = Math.max(1, Math.trunc(Number(Astro.url.searchParams.get('page')) || 1))
let result: BlogSearchResult | null = null
let error = ''
if (q) {
  try {
    result = await searchPosts(q, pageNumber, 10)
  } catch (cause) {
    error = cause instanceof BlogApiError ? cause.message : t(locale, 'common.loadError')
  }
}
const mode = blog.display.postListMode
---
<Layout title={q ? `${t(locale, 'search.title')}: ${q}` : t(locale, 'search.title')} noIndex>
  <MainGridLayout page="search">
    <div class="section-heading">
      <div><h1>{t(locale, 'search.title')}</h1>{result && <p>{result.total} {t(locale, 'search.results')}</p>}</div>
    </div>
    <form class="search-form" action="/search" method="get" role="search" style="max-width:32rem;margin-bottom:1.2rem">
      <label class="sr-only" for="search-page-input">{t(locale, 'search.placeholder')}</label>
      <input id="search-page-input" type="search" name="q" value={q} placeholder={t(locale, 'search.placeholder')} autofocus />
      <button type="submit">{t(locale, 'search.title')}</button>
    </form>
    {error ? (
      <div class="error-state" role="alert"><strong>{t(locale, 'common.loadError')}</strong><p>{error}</p></div>
    ) : !q ? (
      <div class="empty-state">{t(locale, 'search.placeholder')}</div>
    ) : !result || result.items.length === 0 ? (
      <div class="empty-state">{t(locale, 'search.empty')}</div>
    ) : (
      <>
        <div class="post-list" data-post-list data-mode={mode}>
          {result.items.map((post) => <PostCard post={post} mode={mode} />)}
        </div>
        <Pagination page={result.page} total={result.total} limit={result.limit} basePath="/search" baseQuery={`?q=${encodeURIComponent(q)}`} />
      </>
    )}
  </MainGridLayout>
</Layout>
