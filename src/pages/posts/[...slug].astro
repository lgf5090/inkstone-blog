---
import Layout from '../../layouts/Layout.astro'
import '../../styles/reading.css'
import '../../styles/feature-engagement.css'
import MainGridLayout from '../../layouts/MainGridLayout.astro'
import Toc from '../../components/blog/Toc.astro'
import Comments from '../../components/Comments.svelte'
import ArticleImageLightbox from '../../components/blog/ArticleImageLightbox.svelte'
import SharePoster from '../../components/blog/SharePoster.svelte'
import PostEngagement from '../../components/blog/PostEngagement.svelte'
import Icon from '../../components/Icon.astro'
import { blogLocale, t } from '../../i18n'
import { BLOG_VISITOR_COOKIE, mediaUrl, BlogApiError, loadAdjacent, loadComments, loadDiscoveryCandidates, loadEngagement, loadPost, loadPosts, resolveRedirect, unlockPost, userFacingError } from '../../lib/blog-api'
import { formatDate, postUrl, safeRedirectTarget, unlockCookieName } from '../../lib/format'
import type { AdjacentPosts, BlogCommentsResponse, BlogPostDetail, BlogPostSummary, SeriesItem } from '../../lib/blog-types'
import { FALLBACK_SITE } from '../../server/site-config'
import { blogRuntimeOrigin } from '../../server/origins'

const blog = Astro.locals.blog ?? {
  site: FALLBACK_SITE,
  series: [],
  display: { tocDepth: 3 },
  article: { share: true, showLastUpdated: true, lastUpdatedDays: 90, relatedCount: 3, randomCount: 2 },
}
const locale = blogLocale(blog.site.site.locale)
const slug = Astro.params.slug ?? ''
let post: BlogPostDetail | null = null
let adjacent: AdjacentPosts = { previous: null, next: null }
let comments: BlogCommentsResponse | null = null
let error = ''
let protectedPost = false
let unlockHint = ''
let unlockError = ''
const unlockCookie = unlockCookieName(slug)
let unlockToken = Astro.cookies.get(unlockCookie)?.value ?? ''

if (Astro.request.method === 'POST') {
  try {
    const form = await Astro.request.formData()
    const password = typeof form.get('password') === 'string' ? String(form.get('password')) : ''
    const result = await unlockPost(slug, password)
    if (!result.token) {
      unlockError = t(locale, 'unlock.notProtected')
    } else {
      const maxAge = Math.max(60, Math.floor(((result.expiresAt ?? 0) - Date.now()) / 1000))
      Astro.cookies.set(unlockCookie, result.token, {
        httpOnly: true,
        sameSite: 'lax',
        path: '/',
        maxAge,
        secure: Astro.url.protocol === 'https:',
      })
      return Astro.redirect(Astro.url.pathname, 303)
    }
  } catch (cause) {
    unlockError = cause instanceof BlogApiError && cause.status === 403
      ? t(locale, 'unlock.wrong')
      : cause instanceof BlogApiError && cause.status === 429
        ? cause.message
        : t(locale, 'unlock.unavailable')
  }
}

const commentProvider = blog.site.comment?.provider ?? 'none'
const externalComments = commentProvider === 'twikoo' || commentProvider === 'giscus' || commentProvider === 'waline'
const postPromise = loadPost(slug, unlockToken)
const adjacentPromise = loadAdjacent(slug).catch(() => ({ previous: null, next: null }))
const commentsPromise = externalComments ? Promise.resolve(null) : loadComments(slug, unlockToken).catch(() => null)
try {
  post = await postPromise
  ;[adjacent, comments] = await Promise.all([adjacentPromise, commentsPromise])
} catch (cause) {
  if (cause instanceof BlogApiError && cause.status === 404) {
    const redirect: import('../../lib/blog-types').BlogRedirectResult = await resolveRedirect(`/posts/${slug}`).catch(() => ({ found: false }))
    if (redirect.found && redirect.to) {
      const target = safeRedirectTarget(redirect.to, Astro.url.origin)
      if (target) return Astro.redirect(target, (redirect.status ?? 301) as 301 | 302)
    }
    Astro.response.status = 404
    error = t(locale, 'blog.notFound')
  } else if (cause instanceof BlogApiError && cause.status === 403) {
    protectedPost = true
    const details = cause.details as { hint?: unknown } | undefined
    unlockHint = typeof details?.hint === 'string' ? details.hint : ''
    const hadToken = Boolean(unlockToken)
    if (hadToken) {
      Astro.cookies.delete(unlockCookie, { path: '/' })
      unlockToken = ''
    }
    unlockError = unlockError || (hadToken ? t(locale, 'unlock.expired') : '')
  } else {
    error = userFacingError(cause, t(locale, 'common.loadError'))
  }
}

type SeriesContext = {
  slug: string
  name: string
  index: number
  total: number
  prev: BlogPostSummary | null
  next: BlogPostSummary | null
}
let seriesCard: SeriesContext | null = null
let related: BlogPostSummary[] = []
let random: BlogPostSummary[] = []
if (post) {
  const seriesCatalog = (blog.series ?? []) as SeriesItem[]
  const seriesItem = post.series ? seriesCatalog.find((item) => item.name === post!.series || item.slug === post!.series) : undefined
  if (seriesItem) {
    try {
      const items = (await loadPosts({ series: seriesItem.slug, limit: 50 })).items
      const sorted = [...items].sort((a, b) => (a.seriesOrder ?? 0) - (b.seriesOrder ?? 0) || (a.publishedAt ?? 0) - (b.publishedAt ?? 0))
      const index = sorted.findIndex((item) => item.slug === post!.slug)
      if (index >= 0) {
        seriesCard = {
          slug: seriesItem.slug,
          name: seriesItem.name,
          index: index + 1,
          total: sorted.length,
          prev: sorted[index - 1] ?? null,
          next: sorted[index + 1] ?? null,
        }
      }
    } catch (cause) {
      console.warn('[blog] series context failed', cause)
    }
  }
  if (blog.article.relatedCount > 0 || blog.article.randomCount > 0) {
    let candidates: BlogPostSummary[] = []
    try {
      candidates = (await loadDiscoveryCandidates()).filter((item) => item.slug !== post!.slug)
    } catch (cause) {
      console.warn('[blog] discovery candidates failed', cause)
    }
    const scored = candidates
      .map((item) => ({
        item,
        score: item.tags.filter((tag) => post!.tags.includes(tag)).length * 2 + (item.category && item.category === post!.category ? 1 : 0),
      }))
      .filter((entry) => entry.score > 0)
      .sort((a, b) => b.score - a.score || (b.item.publishedAt ?? 0) - (a.item.publishedAt ?? 0))
    related = scored.slice(0, blog.article.relatedCount).map((entry) => entry.item)
    const excludedSlugs = new Set(related.map((item) => item.slug))
    if (adjacent.previous) excludedSlugs.add(adjacent.previous.slug)
    if (adjacent.next) excludedSlugs.add(adjacent.next.slug)
    const rank = (slug: string): number => {
      let hash = 2166136261
      for (const char of `${post!.slug}:${slug}`) {
        hash ^= char.charCodeAt(0)
        hash = Math.imul(hash, 16777619)
      }
      return hash >>> 0
    }
    random = candidates
      .filter((item) => !excludedSlugs.has(item.slug))
      .sort((a, b) => rank(a.slug) - rank(b.slug))
      .slice(0, blog.article.randomCount)
  }
}
const visitorId = Astro.cookies.get(BLOG_VISITOR_COOKIE)?.value ?? ''
let engagement: Awaited<ReturnType<typeof loadEngagement>> | null = null
if (post && !post.encrypted) {
  try {
    engagement = await loadEngagement(post.slug, visitorId)
  } catch (cause) {
    console.warn('[blog] engagement state failed', cause)
  }
}
const updatedDays = post?.updatedAt ? Math.max(0, Math.floor((Date.now() - post.updatedAt) / 86_400_000)) : 0
const showUpdatedNotice = Boolean(post && blog.article.showLastUpdated && post.updatedAt && updatedDays >= blog.article.lastUpdatedDays)
function postLicenseLabel(value: string | undefined): string {
  const raw = value?.trim() ?? ''
  if (!raw || raw === '{}' || raw === 'null') return ''
  if (!raw.startsWith('{')) return raw
  try {
    const parsed = JSON.parse(raw) as { name?: unknown }
    return typeof parsed.name === 'string' ? parsed.name.trim() : ''
  } catch {
    return ''
  }
}
const licenseName = postLicenseLabel(post?.license) || blog.site.license.name
const showLicense = Boolean(post && blog.site.license.enable && licenseName)
const cover = mediaUrl(post?.coverUrl)
const headings = post?.headings ?? []
const titleText = post?.title?.trim() ?? ''
function normalizeHeadingText(value: string): string {
  return value
    .replace(/<[^>]*>/g, '')
    .replace(/&nbsp;/gi, ' ')
    .replace(/&amp;/gi, '&')
    .replace(/&lt;/gi, '<')
    .replace(/&gt;/gi, '>')
    .replace(/&quot;/gi, '"')
    .replace(/&#39;/gi, "'")
    .replace(/\s+/g, ' ')
    .trim()
}
const bodyHtml = post?.render?.html ?? ''
const leadingHeading = /^\s*<h1\b[^>]*>([\s\S]*?)<\/h1>\s*/i.exec(bodyHtml)
const stripLeadingTitle = Boolean(post?.render && titleText && leadingHeading && normalizeHeadingText(leadingHeading[1]) === normalizeHeadingText(titleText))
const articleHtml = stripLeadingTitle ? bodyHtml.replace(/^\s*<h1\b[^>]*>[\s\S]*?<\/h1>\s*/i, '') : bodyHtml
const articleHeadings = stripLeadingTitle
  ? headings.filter((heading, index) => !(index === 0 && heading.depth === 1 && normalizeHeadingText(heading.text) === normalizeHeadingText(titleText)))
  : headings
const discussion = comments?.discussion ?? {
  requireNameEmail: true,
  requireApproval: true,
  allowReplies: true,
  maxLength: 4000,
}
// An external provider lives outside this worker, so `/comments` is not called for it. `enabled`
// still has to be read from the article and the site, or Twikoo/Giscus/Waline mount with `false` and
// the widget never appears — the setting exists but does nothing.
const discussionSettings = blog.site.discussion
const commentsClosedByAge = discussionSettings.autoCloseDays > 0 && post?.publishedAt !== null && post?.publishedAt !== undefined
  && post.publishedAt < Date.now() - discussionSettings.autoCloseDays * 24 * 60 * 60 * 1000
const commentsEnabled = externalComments
  ? Boolean(post?.commentsEnabled && discussionSettings.enabled && !commentsClosedByAge)
  : (comments?.enabled ?? false)
const origin = (blog.site.site.url || import.meta.env.BLOG_SITE_URL || Astro.url.origin).replace(/\/+$/, '')
const permalinkEnabled = Boolean(blog.site.permalink?.enable)
const canonicalPath = postUrl(slug, post?.permalink, permalinkEnabled)
// The permalink route rewrites into this page, so a request that is already on the permalink must
// keep rendering. Only a direct `/posts/:slug` request is the duplicate address to redirect.
if ((Astro.request.method === 'GET' || Astro.request.method === 'HEAD') && permalinkEnabled && post?.permalink) {
  const normalizePath = (value: string): string => {
    let decoded = value
    try { decoded = decodeURIComponent(value) } catch { decoded = value }
    return decoded.replace(/\/+$/, '') || '/'
  }
  if (normalizePath(Astro.originPathname) !== normalizePath(canonicalPath)) {
    return Astro.redirect(`${canonicalPath}${Astro.url.search}`, 301)
  }
}
const canonical = `${origin}${canonicalPath}`
// Posts carry category/tag names; the canonical taxonomy URLs are keyed by slug.
const categoryHref = (name: string): string => `/categories/${encodeURIComponent(blog.categories.find((item) => item.name === name)?.slug ?? name)}`
const tagHref = (name: string): string => `/tags/${encodeURIComponent(blog.tags.find((item) => item.name === name)?.slug ?? name)}`
const runtimeOrigin = blogRuntimeOrigin()
const runtimeVersion = post?.render?.rendererVersion ?? ''
// A plain article keeps its stored still: the runtime is 2 MiB of interactive block code, and the
// still was produced by the same renderer. Load the runtime on the first article interaction rather
// than on idle, so a reader who never touches the body pays nothing for it.
const runtimeNeeded = Boolean(post?.render && (
  (post.render.features?.length ?? 0) > 0 ||
  (post.render.wikiLinks?.length ?? 0) > 0 ||
  (post.render.embeds?.length ?? 0) > 0
))
const runtimeUrl = !post?.render
  ? ''
  : import.meta.env.DEV
    ? (runtimeOrigin ? `${runtimeOrigin}/src/blog-runtime/main.tsx` : '')
    : `/_blog/runtime/${encodeURIComponent(runtimeVersion)}/runtime.js`
const runtimeLabels = {
  copyTable: t(locale, 'runtime.copyTable'),
  copied: t(locale, 'runtime.copied'),
  copyFailed: t(locale, 'common.copyFailed'),
  copySelection: t(locale, 'runtime.copySelection'),
  copyLink: t(locale, 'runtime.copyLink'),
  openImage: t(locale, 'runtime.openImage'),
  copyImage: t(locale, 'runtime.copyImage'),
  backToTop: t(locale, 'runtime.backToTop'),
  article: t(locale, 'runtime.article'),
}
const runtimeAssetBase = !post?.render
  ? ''
  : import.meta.env.DEV
    ? `${runtimeOrigin}/`
    : `/_blog/runtime/${encodeURIComponent(runtimeVersion)}/`
const dualSidebar = blog.site.sidebar?.enable !== false && blog.site.sidebar?.arrangement === 'dual'
const contextMenuConfig = blog.site.contextMenu ?? { enable: true, actions: ['copySelection', 'copyLink', 'openImage', 'copyImage', 'backToTop'] }
const runtimeConfig = post?.render && runtimeNeeded && runtimeUrl
  ? JSON.stringify({
      runtimeUrl,
      runtimeAssetBase,
      runtimeVersion,
      postSlug: post!.slug,
      readerLocale: locale,
      runtimeLabels,
      contextMenuConfig,
      devRuntimeOrigin: import.meta.env.DEV ? runtimeOrigin : '',
      lazy: true,
      stripLeadingTitle,
    })
  : undefined
const jsonLd = post ? {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.description || post.excerpt,
  image: cover ? new URL(cover, origin).href : undefined,
  datePublished: post.publishedAt ? new Date(post.publishedAt).toISOString() : undefined,
  dateModified: new Date(post.updatedAt).toISOString(),
  author: { '@type': 'Person', name: blog.site.profile.name || blog.site.site.title },
  mainEntityOfPage: canonical,
  inLanguage: post.language || blog.site.site.locale,
} : undefined
---

<Layout
  title={post?.title || (protectedPost ? t(locale, 'unlock.title') : t(locale, 'blog.notFound'))}
  description={post?.description || post?.excerpt}
  image={cover}
  type="article"
  canonicalUrl={canonical}
  noIndex={!post}
  jsonLd={jsonLd}
>
  <MainGridLayout page="post">
    {protectedPost ? (
      <div class="article-shell unlock-shell">
        <header class="article-header">
          <h1 class="article-title">{t(locale, 'unlock.title')}</h1>
          <p class="post-card-excerpt">{t(locale, 'unlock.description')}</p>
          {unlockHint && <p class="unlock-hint">{t(locale, 'unlock.hintLabel')}: {unlockHint}</p>}
        </header>
        <div class="article-body">
          {unlockError && <p class="unlock-error" role="alert">{unlockError}</p>}
          <form method="post" class="unlock-form">
            <label class="unlock-label" for="unlock-password">{t(locale, 'unlock.password')}</label>
            <input id="unlock-password" name="password" type="password" required autocomplete="current-password" />
            <button type="submit" class="chip unlock-submit">{t(locale, 'unlock.submit')}</button>
          </form>
        </div>
      </div>
    ) : !post ? (
      <div class="error-state" role="alert">
        <strong>{t(locale, 'blog.notFound')}</strong>
        <p>{error}</p>
        <a class="chip" href="/">{t(locale, 'common.backHome')}</a>
      </div>
    ) : (
      <div class:list={['article-layout', dualSidebar && 'article-layout--single']}>
        <div>
          <article class="article-shell" aria-labelledby="post-title">
            <header class="article-header">
              <a class="chip" href="/">{blog.site.site.title}</a>
              <h1 id="post-title" class="article-title">{post.title || t(locale, 'common.untitled')}</h1>
              <div class="article-meta">
                {post.publishedAt && (
                  <span>{t(locale, 'common.published')} <time datetime={new Date(post.publishedAt).toISOString()}>{formatDate(post.publishedAt, locale, blog.site.site.timeZone)}</time></span>
                )}
                {post.updatedAt && post.publishedAt && post.updatedAt - post.publishedAt > 60_000 && (
                  <span>{t(locale, 'common.updated')} {formatDate(post.updatedAt, locale, blog.site.site.timeZone)}</span>
                )}
                <span>{post.readingMinutes} {t(locale, 'common.minRead')}</span>
                <span>{post.viewCount} {t(locale, 'common.views')}</span>
                {post.category && <a href={categoryHref(post.category)}>{post.category}</a>}
                {blog.article.share && (
                  <>
                    <button type="button" class="article-share" data-share-link={canonical} data-copied-label={t(locale, 'common.copied')} data-copy-failed={t(locale, 'common.copyFailed')}>
                      <Icon name="link" size={12} /> {t(locale, 'common.share')}
                    </button>
                    <SharePoster
                      client:idle
                      title={post.title}
                      description={post.description || post.excerpt}
                      author={blog.site.profile.name || blog.site.site.title}
                      published={post.publishedAt ? formatDate(post.publishedAt, locale, blog.site.site.timeZone) : ''}
                      siteTitle={blog.site.site.title}
                      url={canonical}
                      coverUrl={cover}
                      locale={locale}
                    />
                  </>
                )}
              </div>
              {post.tags.length > 0 && (
                <div class="post-card-tags" aria-label={t(locale, 'common.tags')}>
                  {post.tags.map((tag) => <a class="chip" href={tagHref(tag)}>#{tag}</a>)}
                </div>
              )}
            </header>
            {cover && <img class="article-cover" src={cover} alt="" loading="eager" decoding="async" />}
            <div class="article-body" data-blog-reading-host data-runtime-config={runtimeConfig}>
              {post.render ? (
                <div class="ink-prose" data-blog-snapshot data-post-render set:html={articleHtml} />
              ) : (
                <div class="empty-state" role="status">
                  {t(locale, 'common.loadError')}
                </div>
              )}
            </div>
            {engagement && (
              <PostEngagement client:load slug={post.slug} locale={locale} initial={engagement} />
            )}
          </article>
          <ArticleImageLightbox client:only="svelte" locale={locale} />

          {showUpdatedNotice && post.updatedAt && (
            <p class="article-updated-note" role="note">
              {t(locale, 'common.updated')}
              <time datetime={new Date(post.updatedAt).toISOString()}>{formatDate(post.updatedAt, locale, blog.site.site.timeZone)}</time>
              · {updatedDays} {t(locale, 'article.daysAgo')}
            </p>
          )}

          {seriesCard && (
            <section class="article-block" aria-labelledby="article-series-title">
              <header class="article-block-head">
                <h2 id="article-series-title">{t(locale, 'article.series')}</h2>
                <a href={`/series/${encodeURIComponent(seriesCard.slug)}`}>{seriesCard.name}</a>
                <span class="muted">{t(locale, 'article.partOf').replace('{index}', String(seriesCard.index)).replace('{total}', String(seriesCard.total))}</span>
              </header>
              {(seriesCard.prev || seriesCard.next) && (
                <nav class="article-nav" aria-label={t(locale, 'article.series')}>
                  {seriesCard.prev
                    ? <a href={postUrl(seriesCard.prev.slug, seriesCard.prev.permalink, permalinkEnabled)}>{t(locale, 'common.previousPost')}<strong>{seriesCard.prev.title}</strong></a>
                    : null}
                  {seriesCard.next
                    ? <a href={postUrl(seriesCard.next.slug, seriesCard.next.permalink, permalinkEnabled)}>{t(locale, 'common.nextPost')}<strong>{seriesCard.next.title}</strong></a>
                    : null}
                </nav>
              )}
            </section>
          )}

          {showLicense && (
            <section class="article-license" aria-labelledby="article-license-title">
              <h2 id="article-license-title">{t(locale, 'article.license')}</h2>
              <p class="article-license-work"><strong>{post.title || t(locale, 'common.untitled')}</strong> · <a href={canonical}>{canonical}</a></p>
              <dl>
                <div><dt>{t(locale, 'article.author')}</dt><dd>{blog.site.profile.name || blog.site.site.title}</dd></div>
                {post.publishedAt && <div><dt>{t(locale, 'common.published')}</dt><dd>{formatDate(post.publishedAt, locale, blog.site.site.timeZone)}</dd></div>}
                <div><dt>{t(locale, 'article.license')}</dt><dd>{blog.site.license.url ? <a href={blog.site.license.url} rel="license noopener noreferrer" target="_blank">{licenseName}</a> : licenseName}</dd></div>
              </dl>
            </section>
          )}

          {(related.length > 0 || random.length > 0) && (
            <section class="article-block" aria-labelledby="article-discovery-title">
              <header class="article-block-head">
                <h2 id="article-discovery-title">{t(locale, 'article.continueReading')}</h2>
              </header>
              <div class="article-discovery-lanes">
                {related.length > 0 && (
                  <div class="article-discovery-lane">
                    <h3>{t(locale, 'article.relatedReading')}</h3>
                    <ul>
                      {related.map((item) => (
                        <li>
                          <a href={postUrl(item.slug, item.permalink, permalinkEnabled)}>{item.title || t(locale, 'common.untitled')}</a>
                          <span class="muted">{item.category || formatDate(item.publishedAt ?? 0, locale, blog.site.site.timeZone)}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
                {random.length > 0 && (
                  <div class="article-discovery-lane">
                    <h3>{t(locale, 'article.randomReading')}</h3>
                    <ul>
                      {random.map((item) => (
                        <li>
                          <a href={postUrl(item.slug, item.permalink, permalinkEnabled)}>{item.title || t(locale, 'common.untitled')}</a>
                          <span class="muted">{item.category || formatDate(item.publishedAt ?? 0, locale, blog.site.site.timeZone)}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            </section>
          )}

          {(adjacent.previous || adjacent.next) && (
            <nav class="article-nav" aria-label={t(locale, 'common.postNavigation')}>
              {adjacent.previous
                ? <a href={postUrl(adjacent.previous.slug, adjacent.previous.permalink, permalinkEnabled)}>{t(locale, 'common.previousPost')}<strong>{adjacent.previous.title}</strong></a>
                : null}
              {adjacent.next
                ? <a href={postUrl(adjacent.next.slug, adjacent.next.permalink, permalinkEnabled)}>{t(locale, 'common.nextPost')}<strong>{adjacent.next.title}</strong></a>
                : null}
            </nav>
          )}

          <Comments
            client:idle
            slug={post.slug}
            enabled={commentsEnabled}
            discussion={discussion}
            initial={comments?.items ?? []}
            locale={locale}
            provider={blog.site.comment?.provider ?? 'none'}
            providerConfig={blog.site.comment}
          />
        </div>
        {!dualSidebar && <Toc headings={articleHeadings} depth={blog.display.tocDepth ?? 3} />}
      </div>
    )}
    {dualSidebar && <Toc slot="aside" headings={articleHeadings} depth={blog.display.tocDepth ?? 3} />}
  </MainGridLayout>
</Layout>

