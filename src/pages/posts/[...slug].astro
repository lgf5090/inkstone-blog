---
import Layout from '../../layouts/Layout.astro'
import '../../styles/reading.css'
import MainGridLayout from '../../layouts/MainGridLayout.astro'
import Toc from '../../components/blog/Toc.astro'
import Comments from '../../components/Comments.svelte'
import Icon from '../../components/Icon.astro'
import { blogLocale, t } from '../../i18n'
import { mediaUrl, BlogApiError, loadAdjacent, loadComments, loadPost, resolveRedirect, unlockPost } from '../../lib/blog-api'
import { formatDate, postUrl, unlockCookieName } from '../../lib/format'
import type { AdjacentPosts, BlogCommentsResponse, BlogPostDetail } from '../../lib/blog-types'
import { FALLBACK_SITE } from '../../server/site-config'

const blog = Astro.locals.blog ?? { site: FALLBACK_SITE, display: { tocDepth: 3 }, article: { share: true, showLastUpdated: true } }
const locale = blogLocale(blog.site.site.locale)
const slug = Astro.params.slug ?? ''
let post: BlogPostDetail | null = null
let adjacent: AdjacentPosts = { previous: null, next: null }
let comments: BlogCommentsResponse | null = null
let error = ''
let protectedPost = false
let unlockHint = ''
let unlockError = ''
const unlockCookie = unlockCookieName(slug)
let unlockToken = Astro.cookies.get(unlockCookie)?.value ?? ''

if (Astro.request.method === 'POST') {
  try {
    const form = await Astro.request.formData()
    const password = typeof form.get('password') === 'string' ? String(form.get('password')) : ''
    const result = await unlockPost(slug, password)
    if (!result.token) {
      unlockError = t(locale, 'unlock.notProtected')
    } else {
      const maxAge = Math.max(60, Math.floor(((result.expiresAt ?? 0) - Date.now()) / 1000))
      Astro.cookies.set(unlockCookie, result.token, {
        httpOnly: true,
        sameSite: 'lax',
        path: '/',
        maxAge,
        secure: Astro.url.protocol === 'https:',
      })
      return Astro.redirect(Astro.url.pathname, 303)
    }
  } catch (cause) {
    unlockError = cause instanceof BlogApiError && cause.status === 403
      ? t(locale, 'unlock.wrong')
      : cause instanceof BlogApiError && cause.status === 429
        ? cause.message
        : t(locale, 'unlock.unavailable')
  }
}

try {
  post = await loadPost(slug, unlockToken)
  ;[adjacent, comments] = await Promise.all([
    loadAdjacent(slug).catch(() => ({ previous: null, next: null })),
    loadComments(slug, unlockToken).catch(() => null),
  ])
} catch (cause) {
  if (cause instanceof BlogApiError && cause.status === 404) {
    const redirect: import('../../lib/blog-types').BlogRedirectResult = await resolveRedirect(`/posts/${slug}`).catch(() => ({ found: false }))
    if (redirect.found && redirect.to) return Astro.redirect(redirect.to, (redirect.status ?? 301) as 301 | 302)
    Astro.response.status = 404
    error = t(locale, 'blog.notFound')
  } else if (cause instanceof BlogApiError && cause.status === 403) {
    protectedPost = true
    const details = cause.details as { hint?: unknown } | undefined
    unlockHint = typeof details?.hint === 'string' ? details.hint : ''
    const hadToken = Boolean(unlockToken)
    if (hadToken) {
      Astro.cookies.delete(unlockCookie, { path: '/' })
      unlockToken = ''
    }
    unlockError = unlockError || (hadToken ? t(locale, 'unlock.expired') : '')
  } else {
    error = cause instanceof BlogApiError ? cause.message : t(locale, 'common.loadError')
  }
}

const cover = mediaUrl(post?.coverUrl)
const headings = post?.headings ?? []
const discussion = comments?.discussion ?? {
  requireNameEmail: true,
  requireApproval: true,
  allowReplies: true,
  maxLength: 4000,
}
const origin = (import.meta.env.BLOG_SITE_URL ?? Astro.url.origin).replace(/\/+$/, '')
const canonical = `${origin}${postUrl(slug)}`
const runtimeOrigin = (import.meta.env.BLOG_RUNTIME_ORIGIN || import.meta.env.BLOG_API_ORIGIN || '').replace(/\/+$/, '')
const runtimeVersion = post?.render?.rendererVersion ?? ''
// A plain article keeps its stored still: the runtime is 2 MiB of interactive block code, and the
// still was produced by the same renderer. A post with a rich block or a link that has to resolve
// loads it after idle.
const runtimeNeeded = Boolean(post?.render && (
  (post.render.features?.length ?? 0) > 0 ||
  (post.render.wikiLinks?.length ?? 0) > 0 ||
  (post.render.embeds?.length ?? 0) > 0
))
const runtimeUrl = !post?.render
  ? ''
  : import.meta.env.DEV
    ? (runtimeOrigin ? `${runtimeOrigin}/src/blog-runtime/main.tsx` : '')
    : `/_blog/runtime/${encodeURIComponent(runtimeVersion)}/runtime.js`
const runtimeLabels = {
  copyTable: t(locale, 'runtime.copyTable'),
  copied: t(locale, 'runtime.copied'),
  copyFailed: t(locale, 'common.copyFailed'),
  copySelection: t(locale, 'runtime.copySelection'),
  copyLink: t(locale, 'runtime.copyLink'),
  openImage: t(locale, 'runtime.openImage'),
  copyImage: t(locale, 'runtime.copyImage'),
  backToTop: t(locale, 'runtime.backToTop'),
  article: t(locale, 'runtime.article'),
}
const runtimeAssetBase = !post?.render
  ? ''
  : import.meta.env.DEV
    ? `${runtimeOrigin}/`
    : `/_blog/runtime/${encodeURIComponent(runtimeVersion)}/`
const jsonLd = post ? {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.description || post.excerpt,
  image: cover ? new URL(cover, origin).href : undefined,
  datePublished: post.publishedAt ? new Date(post.publishedAt).toISOString() : undefined,
  dateModified: new Date(post.updatedAt).toISOString(),
  author: { '@type': 'Person', name: blog.site.profile.name || blog.site.site.title },
  mainEntityOfPage: canonical,
  inLanguage: post.language || blog.site.site.locale,
} : undefined
---

<Layout
  title={post?.title || (protectedPost ? t(locale, 'unlock.title') : t(locale, 'blog.notFound'))}
  description={post?.description || post?.excerpt}
  image={cover}
  type="article"
  noIndex={!post}
  jsonLd={jsonLd}
>
  <MainGridLayout page="post">
    {protectedPost ? (
      <div class="article-shell unlock-shell">
        <header class="article-header">
          <h1 class="article-title">{t(locale, 'unlock.title')}</h1>
          <p class="post-card-excerpt">{t(locale, 'unlock.description')}</p>
          {unlockHint && <p class="unlock-hint">{t(locale, 'unlock.hintLabel')}: {unlockHint}</p>}
        </header>
        <div class="article-body">
          {unlockError && <p class="unlock-error" role="alert">{unlockError}</p>}
          <form method="post" class="unlock-form">
            <label class="unlock-label" for="unlock-password">{t(locale, 'unlock.password')}</label>
            <input id="unlock-password" name="password" type="password" required autocomplete="current-password" />
            <button type="submit" class="chip unlock-submit">{t(locale, 'unlock.submit')}</button>
          </form>
        </div>
      </div>
    ) : !post ? (
      <div class="error-state" role="alert">
        <strong>{t(locale, 'blog.notFound')}</strong>
        <p>{error}</p>
        <a class="chip" href="/">{t(locale, 'common.backHome')}</a>
      </div>
    ) : (
      <div class="article-layout">
        <div>
          <article class="article-shell" aria-labelledby="post-title">
            <header class="article-header">
              <a class="chip" href="/">{blog.site.site.title}</a>
              <h1 id="post-title" class="article-title">{post.title || t(locale, 'common.untitled')}</h1>
              <div class="article-meta">
                {post.publishedAt && (
                  <span>{t(locale, 'common.published')} <time datetime={new Date(post.publishedAt).toISOString()}>{formatDate(post.publishedAt, locale, blog.site.site.timeZone)}</time></span>
                )}
                {post.updatedAt && post.publishedAt && post.updatedAt - post.publishedAt > 60_000 && (
                  <span>{t(locale, 'common.updated')} {formatDate(post.updatedAt, locale, blog.site.site.timeZone)}</span>
                )}
                <span>{post.readingMinutes} {t(locale, 'common.minRead')}</span>
                {post.category && <a href={`/categories/${encodeURIComponent(post.category)}`}>{post.category}</a>}
                {blog.article.share && (
                  <button type="button" class="article-share" data-share-link={canonical} data-copied-label={t(locale, 'common.copied')} data-copy-failed={t(locale, 'common.copyFailed')}>
                    <Icon name="link" size={12} /> {t(locale, 'common.share')}
                  </button>
                )}
              </div>
              {post.tags.length > 0 && (
                <div class="post-card-tags" aria-label={t(locale, 'common.tags')}>
                  {post.tags.map((tag) => <a class="chip" href={`/tags/${encodeURIComponent(tag)}`}>#{tag}</a>)}
                </div>
              )}
            </header>
            {cover && <img class="article-cover" src={cover} alt="" loading="eager" decoding="async" />}
            <div class="article-body" data-blog-reading-host>
              {post.render ? (
                <div class="ink-prose" data-blog-snapshot data-post-render set:html={post.render.html} />
              ) : (
                <div class="empty-state" role="status">
                  {t(locale, 'common.loadError')}
                </div>
              )}
            </div>
          </article>

          {(adjacent.previous || adjacent.next) && (
            <nav class="article-nav" aria-label={t(locale, 'common.postNavigation')}>
              {adjacent.previous
                ? <a href={postUrl(adjacent.previous.slug)}>{t(locale, 'common.previousPost')}<strong>{adjacent.previous.title}</strong></a>
                : <span />}
              {adjacent.next
                ? <a href={postUrl(adjacent.next.slug)}>{t(locale, 'common.nextPost')}<strong>{adjacent.next.title}</strong></a>
                : <span />}
            </nav>
          )}

          <Comments
            client:load
            slug={post.slug}
            enabled={comments?.enabled ?? false}
            discussion={discussion}
            initial={comments?.items ?? []}
            locale={locale}
          />
        </div>
        <Toc headings={headings} depth={blog.display.tocDepth ?? 3} />
      </div>
    )}
  </MainGridLayout>
</Layout>

<script is:inline data-astro-rerun>
  document.querySelectorAll('[data-share-link]').forEach((button) => {
    button.addEventListener('click', async () => {
      const link = button.getAttribute('data-share-link')
      if (!link) return
      try {
        await navigator.clipboard.writeText(link)
        const label = button.getAttribute('data-copied-label') || 'Copied'
        const previous = button.textContent
        button.textContent = label
        window.setTimeout(() => { button.textContent = previous }, 1600)
      } catch {
        button.textContent = button.getAttribute('data-copy-failed') || button.textContent
      }
    })
  })
</script>

{post?.render && runtimeNeeded && runtimeUrl && (
  <script is:inline data-astro-rerun define:vars={{ runtimeUrl, runtimeAssetBase, runtimeVersion, postSlug: post.slug, readerLocale: locale, runtimeLabels, devRuntimeOrigin: import.meta.env.DEV ? runtimeOrigin : '' }}>
    (() => {
      const host = document.querySelector('[data-blog-reading-host]')
      const snapshot = host && host.querySelector('[data-blog-snapshot]')
      if (!host || !snapshot || !runtimeUrl) return
      let cancelled = false
      let stage = null
      let handle = null
      window.__blogRegisterCleanup?.('reading', () => {
        cancelled = true
        try {
          handle?.unmount()
        } catch (error) {
          console.warn('[blog] reading runtime cleanup failed', error)
        }
        handle = null
        stage?.remove()
      })
      const keepSnapshot = (error) => {
        console.warn('[blog] reading runtime unavailable; keeping the stored snapshot', error)
      }
      const boot = async () => {
        if (cancelled || !document.contains(host)) return
        try {
          if (devRuntimeOrigin) {
            // The runtime is served by the Inkstone dev server, whose React plugin expects its
            // refresh preamble on the importing page. Production loads a built bundle and never
            // reaches this branch.
            const refresh = await import(devRuntimeOrigin + '/@react-refresh')
            refresh.injectIntoGlobalHook(window)
            window.$RefreshReg$ = () => {}
            window.$RefreshSig$ = () => (type) => type
            window.__vite_plugin_react_preamble_installed__ = true
          }
          await import(runtimeUrl)
        } catch (error) {
          keepSnapshot(error)
          return
        }
        if (cancelled || !document.contains(host)) return
        const reading = window.InkstoneReading
        if (!reading || reading.version !== runtimeVersion) {
          keepSnapshot(new Error('reading runtime version mismatch'))
          return
        }
        let detail
        try {
          const response = await fetch('/_blog/post/' + encodeURIComponent(postSlug), { headers: { accept: 'application/json' } })
          if (!response.ok) throw new Error('post body ' + response.status)
          detail = await response.json()
        } catch (error) {
          keepSnapshot(error)
          return
        }
        if (!detail || typeof detail.content !== 'string') {
          keepSnapshot(new Error('post body missing'))
          return
        }
        if (!devRuntimeOrigin && runtimeAssetBase && !document.querySelector('link[data-blog-runtime-style]')) {
          const style = document.createElement('link')
          style.rel = 'stylesheet'
          style.href = runtimeAssetBase + 'runtime.css'
          style.setAttribute('data-blog-runtime-style', '')
          document.head.appendChild(style)
        }
        if (cancelled || !document.contains(host)) return
        stage = document.createElement('div')
        stage.className = 'blog-runtime-stage'
        host.appendChild(stage)
        const selfPost = '/posts/' + encodeURIComponent(postSlug)
        const wikiLinks = [{ target: detail.title, href: selfPost }]
        for (const link of detail.wikiLinks || []) {
          if (!link || !link.slug || !link.target) continue
          wikiLinks.push({ target: link.target, href: '/posts/' + encodeURIComponent(link.slug) })
        }
        try {
          handle = await reading.mount({
            container: stage,
            content: detail.content,
            noteTitle: detail.title,
            embeds: detail.embeds || [],
            assets: detail.assets || [],
            settings: detail.settings,
            locale: readerLocale,
            assetBase: runtimeAssetBase,
            wikiLinks,
            labels: runtimeLabels,
            tagHref: (name) => '/tags/' + encodeURIComponent(name),
          })
        } catch (error) {
          stage.remove()
          stage = null
          keepSnapshot(error)
          return
        }
        if (cancelled) {
          handle?.unmount()
          handle = null
          stage.remove()
          stage = null
          return
        }
        let attempts = 0
        const reveal = () => {
          if (cancelled) return
          if (!stage.querySelector('[data-preview-content]')) {
            if (++attempts > 120) {
              if (handle) handle.unmount()
              stage.remove()
              keepSnapshot(new Error('reading surface did not render'))
              return
            }
            window.setTimeout(reveal, 16)
            return
          }
          // Removed rather than hidden: both surfaces carry the same heading ids, and a hidden
          // duplicate would win `getElementById` for every TOC anchor and scroll-spy lookup.
          snapshot.remove()
          stage.classList.add('is-ready')
          document.dispatchEvent(new CustomEvent('blog:reading-ready'))
        }
        // A timer rather than requestAnimationFrame: a background tab does not run animation
        // frames, and a reader who opened the article there would keep the still until they returned.
        window.setTimeout(reveal, 16)
      }
      if (typeof window.requestIdleCallback === 'function') window.requestIdleCallback(boot, { timeout: 3000 })
      else window.setTimeout(boot, 200)
    })()
  </script>
)}
