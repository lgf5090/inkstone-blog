---
import Layout from '../../layouts/Layout.astro'
import '../../styles/reading.css'
import { BlogApiError, loadPost, loadSite } from '../../lib/blog-api'
import type { BlogPostDetail, BlogSitePublic } from '../../lib/blog-types'

const slug = Astro.params.slug ?? ''
let site: BlogSitePublic | null = null
let post: BlogPostDetail | null = null
let error = ''

try {
  ;[site, post] = await Promise.all([loadSite(), loadPost(slug)])
} catch (cause) {
  if (cause instanceof BlogApiError && cause.status === 404) return Astro.redirect('/404')
  error = cause instanceof BlogApiError && cause.status === 403
    ? 'This post is protected.'
    : 'This post could not be loaded.'
}

const headings = post?.headings.filter((heading) => heading.depth <= 3) ?? []

function formatDate(value: number | null): string {
  if (!value || !post) return ''
  try {
    return new Intl.DateTimeFormat(site?.site.locale ?? 'en', {
      dateStyle: 'long',
      timeZone: site?.site.timeZone || undefined,
    }).format(new Date(value))
  } catch {
    return new Date(value).toISOString().slice(0, 10)
  }
}
---

<Layout
  site={site}
  title={post ? `${post.title} · ${site?.site.title ?? 'Inkstone Blog'}` : 'Inkstone Blog'}
  description={post?.description || post?.excerpt || undefined}
>
  {error || !post ? (
    <div role="alert" class="rounded-2xl border border-white/10 bg-white/[0.03] p-8 text-sm text-slate-400">
      <p class="font-medium text-white">{error || 'Post not found.'}</p>
      <a href="/" class="mt-4 inline-block rounded-full border border-white/15 px-3 py-1.5 hover:bg-white/10">
        Back to posts
      </a>
    </div>
  ) : (
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_220px]">
      <article aria-labelledby="post-title">
        <header class="mb-8 border-b border-white/10 pb-6">
          <a href="/" class="text-xs font-medium tracking-[0.18em] text-slate-500 uppercase hover:text-sky-300">
            Inkstone Blog
          </a>
          <h1 id="post-title" class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
            {post.title || 'Untitled'}
          </h1>
          <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-500">
            {post.publishedAt && <time datetime={new Date(post.publishedAt).toISOString()}>{formatDate(post.publishedAt)}</time>}
            <span>{post.readingMinutes} min read</span>
            {post.category && <span>{post.category}</span>}
          </div>
          {post.tags.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-1.5 text-[11px] text-slate-500">
              {post.tags.map((tag) => <span class="rounded-full border border-white/10 px-2 py-0.5">#{tag}</span>)}
            </div>
          )}
        </header>

        {post.render ? (
          <div class="ink-prose" data-post-render set:html={post.render.html} />
        ) : (
          <div role="status" class="rounded-2xl border border-amber-300/20 bg-amber-300/5 p-6 text-sm text-amber-100/80">
            This post has no public render yet. Publish it from the blog admin to build one.
          </div>
        )}
      </article>

      {headings.length > 0 && (
        <aside aria-label="Table of contents" class="hidden lg:block">
          <div class="sticky top-6">
            <p class="mb-3 text-xs font-medium tracking-[0.16em] text-slate-500 uppercase">On this page</p>
            <nav class="border-l border-white/10">
              <ol class="space-y-1 text-xs">
                {headings.map((heading) => (
                  <li style={`padding-left: ${Math.max(0, heading.depth - 1) * 10}px`}>
                    <a href={`#${heading.slug}`} class="block border-l border-transparent py-1 pl-3 text-slate-400 hover:border-sky-400 hover:text-sky-300">
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          </div>
        </aside>
      )}
    </div>
  )}
</Layout>
